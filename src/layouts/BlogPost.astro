---
import entrypoints from "../data/article-entrypoints.json";
import ShareLinks from "../components/ShareLinks.astro";
import { readingGuides } from "../data/reading-guides";
import { thumbnailAttrs } from "../lib/thumbnails";
import NextRead from "../components/NextRead.astro";
import guides from "../data/article-guides.json";
import FollowNote from "../components/FollowNote.astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { journalPosts } from "../lib/posts";
import AdSense from "../components/AdSense.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { AUTHOR_NAME, SITE_TITLE } from "../consts";

type Props = CollectionEntry<"blog">["data"] & { headings?: { depth: number; slug: string; text: string }[] };

const {
  title,
  seoTitle,
  affiliate = false,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  headings = [],
} = Astro.props;

const slug = Astro.url.pathname.split('/').filter(Boolean).at(-1) || '';
const guide = guides[slug as keyof typeof guides];
const entrypoint = entrypoints[slug as keyof typeof entrypoints];
const collections = readingGuides.filter(g => g.items.some(item => item.slug === slug));
const preview = guide ? `/articles/${slug}/cover.webp` : undefined;
// Get related posts: prefer posts with shared tags, fallback to recent posts
const allPosts = (await journalPosts())
  .filter((p) => p.data.title !== title)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const relatedPosts = (() => {
  if (tags.length > 0) {
    const withSharedTags = allPosts
      .map((p) => ({
        post: p,
        sharedTags: (p.data.tags || []).filter((t: string) => tags.includes(t))
          .length,
      }))
      .filter((p) => p.sharedTags > 0)
      .sort((a, b) => b.sharedTags - a.sharedTags)
      .map((p) => p.post);
    return [...withSharedTags, ...allPosts.filter(p => !withSharedTags.includes(p))].slice(0, 3);
  }
  return allPosts.slice(0, 3);
})();

const articleJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  inLanguage: "ja",
  headline: title,
  description: description,
  author: {
    "@type": "Person",
    name: AUTHOR_NAME,
    url: new URL("/about/", Astro.site).href,
  },
  publisher: {
    "@type": "Person",
    name: AUTHOR_NAME,
  },
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  image: new URL(heroImage?.src ?? preview ?? "/social-card.png", Astro.site).toString(),
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(Astro.url.pathname, Astro.site).href,
  },
});

const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: Astro.site?.toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: new URL("/blog/", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: title,
    },
  ],
});
---

<html lang="ja">
  <head>
    <BaseHead
      title={`${seoTitle ?? title} | ${SITE_TITLE}`}
      description={description}
      image={heroImage}
      socialImagePath={heroImage ? undefined : preview}
      type="article"
      publishedTime={pubDate}
      updatedTime={updatedDate}
      tags={tags}
    />
    <script type="application/ld+json" set:html={articleJsonLd.replace(/</g, '\\u003c')} />
    <script type="application/ld+json" set:html={breadcrumbJsonLd.replace(/</g, '\\u003c')} />
    <style>
      .affiliate-disclosure { padding: 16px; margin: 18px 0; border: 1px solid #b8c2c9; border-radius: 8px; background: #f6f8fa; font-size: 14px; line-height: 1.8; }
      .prose :global(.affiliate-product) { margin-top: 24px; padding-top: 16px; border-top: 1px dashed var(--line); overflow-x: auto; }
      .prose :global(.affiliate-product > p) { font-size: 14px; line-height: 1.8; }
      .prose :global(.affiliate-product img[width="1"]) { width: 1px; height: 1px; margin: 0; border: 0; }
      .article-outcome { background: #f6f8fc; border: 1px solid #c5d3e3; padding: 22px; border-radius: 10px; margin: 24px 0; }
      .article-outcome h2 { font-size: 20px; margin: 0 0 12px; }
      .article-outcome p { font-size: 15px; line-height: 1.9; }
      .article-outcome .evidence { font-size: 12px; color: #53616a; }
      .article-outcome img { width: 100%; height: auto; border-radius: 6px; }
      .article-outcome figure { margin: 18px 0; }
      .article-outcome figcaption { font-size: 12px; color: var(--muted); }
      .resource-link { display: inline-block; padding: 10px 14px; background: #ffedb2; border: 1px solid #34434d; border-radius: 5px; }
      .article-feedback { border-top: 1px dashed #aab6c0; margin-top: 40px; padding-top: 18px; font-size: 13px; }
      .article-feedback button { background: white; border: 1px solid #34434d; padding: 12px; border-radius: 5px; cursor: pointer; font: inherit; }
      #copy-result { display: block; margin-top: 8px; overflow-wrap: anywhere; }
      .related-description { font-size: 13px; color: var(--muted); line-height: 1.8; margin-bottom: 8px; }
      main {
        width: min(1100px, calc(100% - 40px));
        margin: 0 auto;
        padding-top: 35px;
      }
      .article-author { font-size: 13px; margin: 0 0 22px; }
      .article-toc { margin: 24px 0; padding: 16px 20px; background: #f7f5eb; border-radius: 6px; font-size: 14px; }
      .article-toc summary { cursor: pointer; font-weight: 600; }
      .article-toc ul { padding-left: 20px; line-height: 2; }
      .breadcrumb {
        font-size: 11px;
        color: var(--muted);
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 45px;
      }
      .breadcrumb a {
        text-decoration: none;
      }
      .hero-image {
        max-width: 800px;
        margin: 0 auto 30px;
      }
      .hero-image img {
        display: block;
        width: 100%;
      }
      .title {
        margin-bottom: 40px;
      }
      .title h1 {
        font: clamp(28px, 4vw, 44px)/1.6 var(--serif);
        margin: 18px 0 30px;
        letter-spacing: 0.01em;
      }
      .date {
        font-size: 12px;
        color: var(--muted);
      }
      .title hr {
        border-top-color: var(--ink);
      }
      .related-posts {
        max-width: 720px;
        margin: 65px auto 0;
        border-top: 1px solid var(--ink);
        padding-top: 25px;
      }
      .related-posts h2 {
        font-size: 22px;
        margin-bottom: 24px;
      }
      .related-posts ul {
        list-style: none;
        padding: 0;
      }
      .related-posts li a {
        display: block;
        padding: 20px 0;
        border-bottom: 1px solid var(--line);
        text-decoration: none;
      }
      .related-posts img { display:block; width:120px; height:auto; border-radius:5px; }
      .related-posts li a:has(img) { display:grid; grid-template-columns:120px minmax(0,1fr); gap:18px; align-items:start; }
      .topic-return { display:flex; gap:10px 18px; flex-wrap:wrap; font-size:13px; margin:24px 0; }
      .try-lab {padding:22px;background:#edf3ef;border-radius:8px;}
      .try-lab p {font-size:14px;}
      .related-posts h3 {
        font-size: 17px;
        margin-bottom: 8px;
      }
      .prose :global(img),
      .prose :global(iframe) {
        max-width: 100%;
      }
      .prose :global(pre) { max-width: 100%; overflow-x: auto; }
      .prose :global(figure) { margin: 28px 0; }
      .prose :global(figure img) { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: 10px; }
      .prose :global(figcaption), .prose :global(.source) { font-size: 13px; line-height: 1.8; color: var(--muted); margin-top: 10px; }
      .prose :global(.proof) { padding: 14px 18px; background: #eef4ef; border-radius: 8px; font-size: 13px; }
      .prose :global(.voice) { font-size: 1.12em; color: #315f91; }
      .prose :global(.card) { border: 1px solid var(--line); padding: 20px; border-radius: 10px; margin: 24px 0; }
      .prose :global(.card h3) { margin-top: 0; }

      .prose :global(.command-pair) { margin: 24px 0 32px; }
      .prose :global(.command-label), .prose :global(.result-label) { font-size: 13px; font-weight: 700; margin: 12px 0 4px; }
      .prose :global(.command-pair pre) { margin: 0 0 8px; white-space: pre; }
      .prose :global(pre.command) { background: #edf3fa; color: #34434d; border-left: 4px solid #315e91; }
      .prose :global(pre.result) { background: #f1f5ef; color: #34434d; border-left: 4px solid #718b70; }
      .prose :global(.checkpoint) { font-size: 15px; margin-top: 8px; }
      .prose :global(.note), .prose :global(.summary) { padding: 16px 20px; background: #f1f5ef; border-radius: 8px; }
      .prose :global(.note) { font-size: 13px; }
      .prose :global(.step-nav) { display: flex; flex-wrap: wrap; gap: 12px 18px; margin: 20px 0; font-size: 14px; }
      .prose :global(details) { padding: 14px; border: 1px solid var(--line); border-radius: 8px; margin: 20px 0; }
      .prose :global(summary) { cursor: pointer; font-weight: 600; }
    </style>
  </head>

  <body>
    <Header />
    <main id="main">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/blog/">Blog</a>
        <span>/</span>
        <span>{title}</span>
      </nav>
      <article>
        <div class="hero-image">
          {heroImage && (
            <Image
              width={1020}
              height={536}
              widths={[480, 768, 1020]}
              sizes="(max-width: 700px) 100vw, 1020px"
              loading="eager"
              fetchpriority="high"
              src={heroImage}
              alt={`${title} のヒーロー画像`}
            />
          )}
        </div>
        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={pubDate} />
              {updatedDate && (
                <div class="last-updated-on">
                  最終更新: <FormattedDate date={updatedDate} />
                </div>
              )}
            </div>
            <h1>{title}</h1>
            <hr />
          </div>
          <p class="article-author">書いた人：<a href="/about/">{AUTHOR_NAME}</a></p>
          {affiliate && <aside class="affiliate-disclosure"><strong>広告</strong> この記事にはアフィリエイト広告を含みます。リンク経由の購入・申し込みにより運営者が報酬を受け取ることがあります。<a href="/advertising/">掲載方針</a></aside>}
          {entrypoint && <section class="article-outcome" aria-label="この記事でできること"><h2>先に、できることだけ。</h2><p>{entrypoint.result}</p><p class="evidence">{entrypoint.target}</p></section>}
          {guide && <section class="article-outcome" aria-label="この記事でわかること">
            <h2>こんなことを試しました。</h2><p>{guide.summary}</p>
            <p class="evidence">{guide.evidence}</p>
            <figure><img src={`/articles/${slug}/preview.webp`} alt={guide.alt} width="1200" height="630" decoding="async" loading="lazy" /><figcaption>{guide.alt}</figcaption></figure>
            {'resource' in guide && <a class="resource-link" href={guide.resource}>{guide.resourceLabel} ↗</a>}
          </section>}
          {headings.filter(h => h.depth === 2).length > 2 && (
            <details class="article-toc">
              <summary>この記事の目次</summary>
              <ul>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
            </details>
          )}
          <slot />
          <NextRead slug={slug} />
          {collections.length > 0 && <nav class="topic-return" aria-label="同じテーマの記事"><span>このテーマをまとめて読む：</span>{collections.map(g=><a href={`/blog/guides/${g.slug}/`}>{g.label} →</a>)}</nav>}
          {slug === 'css-popout-drawer' && <aside class="try-lab"><strong>ほかの仕掛けも、触ってみる？</strong><p>磁石、配線、ぷにぷにボタン。設定を変えながら遊べる6つの実験を公開しています。</p><a href="/playground/">仕掛けの実験室へ →</a></aside>}
          <ShareLinks title={title} />
          <aside class="article-feedback"><p>試してみてつまずいたことや、記事の訂正は<a href="/contact/">お問い合わせフォーム</a>へどうぞ。対象の記事URLを添えていただけると助かります。</p></aside>
          <AdSense slot="in-article" format="rectangle" />
        </div>
        {relatedPosts.length > 0 && (
          <aside class="related-posts">
            <h2>こちらも、のぞいてみる？</h2>
            <ul>
              {relatedPosts.map((post) => (
                <li>
                  <a href={`/blog/${post.id}/`}>
                    {post.data.heroImage && (
                      <img {...thumbnailAttrs(post.id,post.data.heroImage.src,'120px')} width="120" height="63" loading="lazy" decoding="async" alt="" />
                    )}
                    <div class="related-post-info">
                      <h3>{post.data.title}</h3>
                      <p class="related-description">{post.data.description}</p>
                      <p class="date">
                        <FormattedDate date={post.data.pubDate} />
                      </p>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </article>
      <FollowNote />
    </main>

    <Footer />

  </body>
</html>
