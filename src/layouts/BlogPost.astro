---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { journalPosts } from "../lib/posts";
import AdSense from "../components/AdSense.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { AUTHOR_NAME, SITE_TITLE } from "../consts";

type Props = CollectionEntry<"blog">["data"];

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
} = Astro.props;

// Get related posts: prefer posts with shared tags, fallback to recent posts
const allPosts = (await journalPosts())
  .filter((p) => p.data.title !== title)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const relatedPosts = (() => {
  if (tags.length > 0) {
    const withSharedTags = allPosts
      .map((p) => ({
        post: p,
        sharedTags: (p.data.tags || []).filter((t: string) => tags.includes(t))
          .length,
      }))
      .filter((p) => p.sharedTags > 0)
      .sort((a, b) => b.sharedTags - a.sharedTags)
      .map((p) => p.post);
    if (withSharedTags.length >= 2) return withSharedTags.slice(0, 3);
  }
  return allPosts.slice(0, 3);
})();

const articleJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: description,
  author: {
    "@type": "Person",
    name: AUTHOR_NAME,
    url: Astro.site?.toString(),
  },
  publisher: {
    "@type": "Person",
    name: AUTHOR_NAME,
  },
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  ...(heroImage && {
    image: new URL(heroImage.src, Astro.site).toString(),
  }),
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": Astro.url.toString(),
  },
});

const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: Astro.site?.toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: new URL("/blog/", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: title,
    },
  ],
});
---

<html lang="ja">
  <head>
    <BaseHead
      title={`${title} | ${SITE_TITLE}`}
      description={description}
      image={heroImage}
      type="article"
      publishedTime={pubDate}
      updatedTime={updatedDate}
      tags={tags}
    />
    <script type="application/ld+json" set:html={articleJsonLd} />
    <script type="application/ld+json" set:html={breadcrumbJsonLd} />
    <style>
      main {
        width: min(1100px, calc(100% - 40px));
        margin: 0 auto;
        padding-top: 35px;
      }
      .breadcrumb {
        font-size: 11px;
        color: var(--muted);
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 45px;
      }
      .breadcrumb a {
        text-decoration: none;
      }
      .hero-image {
        max-width: 800px;
        margin: 0 auto 30px;
      }
      .hero-image img {
        display: block;
        width: 100%;
      }
      .title {
        margin-bottom: 40px;
      }
      .title h1 {
        font: clamp(28px, 4vw, 44px)/1.6 var(--serif);
        margin: 18px 0 30px;
        letter-spacing: 0.01em;
      }
      .date {
        font-size: 12px;
        color: var(--muted);
      }
      .title hr {
        border-top-color: var(--ink);
      }
      .related-posts {
        max-width: 720px;
        margin: 65px auto 0;
        border-top: 1px solid var(--ink);
        padding-top: 25px;
      }
      .related-posts h2 {
        font-size: 22px;
        margin-bottom: 24px;
      }
      .related-posts ul {
        list-style: none;
        padding: 0;
      }
      .related-posts li a {
        display: block;
        padding: 20px 0;
        border-bottom: 1px solid var(--line);
        text-decoration: none;
      }
      .related-posts img {
        display: none;
      }
      .related-posts h3 {
        font-size: 17px;
        margin-bottom: 8px;
      }
      .prose :global(img),
      .prose :global(iframe) {
        max-width: 100%;
      }
      .prose :global(pre) {
        max-width: 100%;
      }
    </style>
  </head>

  <body>
    <Header />
    <main id="main">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/blog/">Blog</a>
        <span>/</span>
        <span>{title}</span>
      </nav>
      <article>
        <div class="hero-image">
          {heroImage && (
            <Image
              width={1020}
              height={510}
              src={heroImage}
              alt={`${title} のヒーロー画像`}
            />
          )}
        </div>
        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={pubDate} />
              {updatedDate && (
                <div class="last-updated-on">
                  最終更新: <FormattedDate date={updatedDate} />
                </div>
              )}
            </div>
            <h1>{title}</h1>
            <hr />
          </div>
          <slot />
          <AdSense slot="in-article" format="rectangle" />
        </div>
        {relatedPosts.length > 0 && (
          <aside class="related-posts">
            <h2>関連記事</h2>
            <ul>
              {relatedPosts.map((post) => (
                <li>
                  <a href={`/blog/${post.id}/`}>
                    {post.data.heroImage && (
                      <Image
                        width={360}
                        height={180}
                        src={post.data.heroImage}
                        alt={`${post.data.title} のサムネイル`}
                      />
                    )}
                    <div class="related-post-info">
                      <h3>{post.data.title}</h3>
                      <p class="date">
                        <FormattedDate date={post.data.pubDate} />
                      </p>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </article>
    </main>
    <AdSense slot="footer" format="horizontal" className="footer-ad" />
    <Footer />
  </body>
</html>
