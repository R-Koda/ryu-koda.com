---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { journalPosts } from "../lib/posts";
import AdSense from "../components/AdSense.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { AUTHOR_NAME, SITE_TITLE } from "../consts";

type Props = CollectionEntry<"blog">["data"] & { headings?: { depth: number; slug: string; text: string }[] };

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  headings = [],
} = Astro.props;

// Get related posts: prefer posts with shared tags, fallback to recent posts
const allPosts = (await journalPosts())
  .filter((p) => p.data.title !== title)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const relatedPosts = (() => {
  if (tags.length > 0) {
    const withSharedTags = allPosts
      .map((p) => ({
        post: p,
        sharedTags: (p.data.tags || []).filter((t: string) => tags.includes(t))
          .length,
      }))
      .filter((p) => p.sharedTags > 0)
      .sort((a, b) => b.sharedTags - a.sharedTags)
      .map((p) => p.post);
    if (withSharedTags.length >= 2) return withSharedTags.slice(0, 3);
  }
  return allPosts.slice(0, 3);
})();

const articleJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  inLanguage: "ja",
  headline: title,
  description: description,
  author: {
    "@type": "Person",
    name: AUTHOR_NAME,
    url: new URL("/about/", Astro.site).href,
  },
  publisher: {
    "@type": "Person",
    name: AUTHOR_NAME,
  },
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  ...(heroImage && {
    image: new URL(heroImage.src, Astro.site).toString(),
  }),
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(Astro.url.pathname, Astro.site).href,
  },
});

const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: Astro.site?.toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: new URL("/blog/", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: title,
    },
  ],
});
---

<html lang="ja">
  <head>
    <BaseHead
      title={`${title} | ${SITE_TITLE}`}
      description={description}
      image={heroImage}
      type="article"
      publishedTime={pubDate}
      updatedTime={updatedDate}
      tags={tags}
    />
    <script type="application/ld+json" set:html={articleJsonLd.replace(/</g, '\\u003c')} />
    <script type="application/ld+json" set:html={breadcrumbJsonLd.replace(/</g, '\\u003c')} />
    <style>
      main {
        width: min(1100px, calc(100% - 40px));
        margin: 0 auto;
        padding-top: 35px;
      }
      .article-author { font-size: 13px; margin: 0 0 22px; }
      .article-toc { margin: 24px 0; padding: 16px 20px; background: #f7f5eb; border-radius: 6px; font-size: 14px; }
      .article-toc summary { cursor: pointer; font-weight: 600; }
      .article-toc ul { padding-left: 20px; line-height: 2; }
      .breadcrumb {
        font-size: 11px;
        color: var(--muted);
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 45px;
      }
      .breadcrumb a {
        text-decoration: none;
      }
      .hero-image {
        max-width: 800px;
        margin: 0 auto 30px;
      }
      .hero-image img {
        display: block;
        width: 100%;
      }
      .title {
        margin-bottom: 40px;
      }
      .title h1 {
        font: clamp(28px, 4vw, 44px)/1.6 var(--serif);
        margin: 18px 0 30px;
        letter-spacing: 0.01em;
      }
      .date {
        font-size: 12px;
        color: var(--muted);
      }
      .title hr {
        border-top-color: var(--ink);
      }
      .related-posts {
        max-width: 720px;
        margin: 65px auto 0;
        border-top: 1px solid var(--ink);
        padding-top: 25px;
      }
      .related-posts h2 {
        font-size: 22px;
        margin-bottom: 24px;
      }
      .related-posts ul {
        list-style: none;
        padding: 0;
      }
      .related-posts li a {
        display: block;
        padding: 20px 0;
        border-bottom: 1px solid var(--line);
        text-decoration: none;
      }
      .related-posts img {
        display: none;
      }
      .related-posts h3 {
        font-size: 17px;
        margin-bottom: 8px;
      }
      .prose :global(img),
      .prose :global(iframe) {
        max-width: 100%;
      }
      .prose :global(pre) { max-width: 100%; overflow-x: auto; }
      .prose :global(figure) { margin: 28px 0; }
      .prose :global(figure img) { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: 10px; }
      .prose :global(figcaption), .prose :global(.source) { font-size: 13px; line-height: 1.8; color: var(--muted); margin-top: 10px; }
      .prose :global(.proof) { padding: 14px 18px; background: #eef4ef; border-radius: 8px; font-size: 13px; }
      .prose :global(.voice) { font-size: 1.12em; color: #315f91; }
      .prose :global(.card) { border: 1px solid var(--line); padding: 20px; border-radius: 10px; margin: 24px 0; }
      .prose :global(.card h3) { margin-top: 0; }

    </style>
  </head>

  <body>
    <Header />
    <main id="main">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/blog/">Blog</a>
        <span>/</span>
        <span>{title}</span>
      </nav>
      <article>
        <div class="hero-image">
          {heroImage && (
            <Image
              width={1020}
              height={510}
              src={heroImage}
              alt={`${title} のヒーロー画像`}
            />
          )}
        </div>
        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={pubDate} />
              {updatedDate && (
                <div class="last-updated-on">
                  最終更新: <FormattedDate date={updatedDate} />
                </div>
              )}
            </div>
            <h1>{title}</h1>
            <hr />
          </div>
          <p class="article-author">書いた人：<a href="/about/">{AUTHOR_NAME}</a></p>
          {headings.filter(h => h.depth === 2).length > 2 && (
            <details class="article-toc">
              <summary>この記事の目次</summary>
              <ul>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
            </details>
          )}
          <slot />
          <AdSense slot="in-article" format="rectangle" />
        </div>
        {relatedPosts.length > 0 && (
          <aside class="related-posts">
            <h2>関連記事</h2>
            <ul>
              {relatedPosts.map((post) => (
                <li>
                  <a href={`/blog/${post.id}/`}>
                    {post.data.heroImage && (
                      <Image
                        width={360}
                        height={180}
                        src={post.data.heroImage}
                        alt={`${post.data.title} のサムネイル`}
                      />
                    )}
                    <div class="related-post-info">
                      <h3>{post.data.title}</h3>
                      <p class="date">
                        <FormattedDate date={post.data.pubDate} />
                      </p>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </article>
    </main>
    <AdSense slot="footer" format="horizontal" className="footer-ad" />
    <Footer />
  </body>
</html>
