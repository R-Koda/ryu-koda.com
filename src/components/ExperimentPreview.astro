---
const {kind}=Astro.props;
---
<div class="preview" data-preview={kind} aria-hidden="true">
<svg viewBox="0 0 280 110" fill="none" stroke="#354550" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<path d="M16 98h248" stroke="#354550" opacity=".2" stroke-dasharray="2 5"/>
{kind==='magnets' && <><g class="magnet"><path d="M116 33v28a24 24 0 0 0 48 0V33" stroke="#b56560" stroke-width="16"/><path d="M116 33v12m48-12v12" stroke="#fffdf6" stroke-width="12"/></g><g class="chip chip-a"><rect x="36" y="63" width="22" height="10" rx="5" fill="white"/></g><g class="chip chip-b"><rect x="224" y="38" width="22" height="10" rx="5" fill="white"/></g><g class="chip chip-c"><circle cx="214" cy="83" r="7" fill="#e6bb5d"/></g><g class="spark"><path d="m140 13 0 8m-45 8-7-5m99 5 7-5"/></g></>}
{kind==='chain' && <><path d="m25 38 56 50h154"/><circle class="rolling-ball" cx="35" cy="28" r="10" fill="#e6bb5d"/>{[0,1,2,3].map(i=><rect class={`domino domino-${i}`} x={104+i*32} y="47" width="11" height="40" rx="2" fill={i%2?'#e3eee6':'#dce7f5'} style={`transform-origin:${110+i*32}px 87px`}/>)}<path class="spark" d="m245 44 0-10m-9 14-8-5m25 5 8-5"/></>}
{kind==='buttons' && <>{[0,1,2].map((i)=><g class={`cap cap-${i}`} style={`transform-origin:${65+i*75}px 78px`}><rect x={36+i*75} y="37" width="58" height="48" rx={i===1?'22':'10'} fill="#354550"/><rect x={36+i*75} y="29" width="58" height="48" rx={i===1?'22':'10'} fill={['#e3eee6','#e8dff5','#fff0bc'][i]}/><path d={`M${55+i*75} 50h20m-10-10v20`}/></g>)}</>}
{kind==='cables' && <><rect x="162" y="18" width="89" height="58" rx="6" fill="#f8f6ee"/><rect class="screen" x="170" y="26" width="73" height="42" rx="2" fill="#44515a"/><path d="M207 77v15m-20 0h40"/><g class="plug"><path d="M20 88c75 0 10-45 80-45" stroke="#6b83b2" stroke-width="6"/><rect x="99" y="33" width="23" height="20" rx="4" fill="white"/><path d="M123 38h12m-12 10h12"/></g><path class="screen-check" d="m191 46 10 10 21-24" stroke="#fff" stroke-width="4"/></>}
{kind==='study' && <><rect x="185" y="14" width="62" height="52" rx="3" fill="#cbe3ed"/><path d="M216 14v52m-31-26h62"/><path class="beam" d="m83 42-40 52h129l-58-52" fill="#ffe59a" stroke="none"/><path d="M24 94h232M68 91h49M91 90V57l15-19" stroke-width="4"/><path class="shade" d="m88 23 33 8-3 26-46-12z" fill="#e4cb80"/><ellipse class="shadow" cx="169" cy="90" rx="30" ry="4" fill="#354550" opacity=".2"/><rect x="148" y="59" width="44" height="29" rx="3" fill="#dce7df"/><path d="M156 68h28"/></>}
{kind==='letters' && <>{['W','E','B'].map((letter,i)=><g class={`letter letter-${i}`} style={`transform-origin:${83+i*57}px 90px`}><rect x={60+i*57} y="42" width="46" height="46" rx="7" fill={['#fff0bc','#e3eee6','#e8dff5'][i]}/><text x={83+i*57} y="73" text-anchor="middle" stroke="none" fill="#354550" font-size="24" font-family="sans-serif">{letter}</text></g>)}</>}
</svg>
</div>
<style>
.preview{height:120px;margin:16px -8px 4px;background:#ffffff55;border-radius:12px;overflow:hidden;pointer-events:none}.preview svg{width:100%;height:100%}.chip,.plug,.screen,.beam,.shadow,.shade,.screen-check,.spark{transition:transform .6s cubic-bezier(.2,.8,.2,1),opacity .3s,fill .4s}.spark,.screen-check{opacity:0}.beam{opacity:.15}.shadow{transform-origin:169px 90px}.preview :global(text){user-select:none}
:global(.kit:is(:hover,:focus-visible)) .chip-a{transform:translate(65px,-10px) rotate(-4deg)}:global(.kit:is(:hover,:focus-visible)) .chip-b{transform:translate(-55px,15px)}:global(.kit:is(:hover,:focus-visible)) .chip-c{transform:translate(-34px,-12px)}:global(.kit:is(:hover,:focus-visible)) .spark{opacity:1;transition-delay:.5s}
:global(.kit:is(:hover,:focus-visible)) .rolling-ball{animation:roll .8s ease-in-out both}:global(.kit:is(:hover,:focus-visible)) .domino{animation:fall .45s ease-in both}:global(.kit:is(:hover,:focus-visible)) .domino-0{animation-delay:.5s}:global(.kit:is(:hover,:focus-visible)) .domino-1{animation-delay:.62s}:global(.kit:is(:hover,:focus-visible)) .domino-2{animation-delay:.74s}:global(.kit:is(:hover,:focus-visible)) .domino-3{animation-delay:.86s}
:global(.kit:is(:hover,:focus-visible)) .cap{animation:squish .7s both}:global(.kit:is(:hover,:focus-visible)) .cap-1{animation-delay:.12s}:global(.kit:is(:hover,:focus-visible)) .cap-2{animation-delay:.24s}
:global(.kit:is(:hover,:focus-visible)) .plug{transform:translateX(27px)}:global(.kit:is(:hover,:focus-visible)) .screen{fill:#608e78;transition-delay:.3s}:global(.kit:is(:hover,:focus-visible)) .screen-check{opacity:1;transition-delay:.45s}
:global(.kit:is(:hover,:focus-visible)) .beam{opacity:.85}:global(.kit:is(:hover,:focus-visible)) .shade{fill:#ffe294}:global(.kit:is(:hover,:focus-visible)) .shadow{transform:translateX(10px) scaleX(1.3)}
:global(.kit:is(:hover,:focus-visible)) .letter{animation:hop .75s both}:global(.kit:is(:hover,:focus-visible)) .letter-1{animation-delay:.1s}:global(.kit:is(:hover,:focus-visible)) .letter-2{animation-delay:.2s}
@keyframes roll{to{transform:translate(60px,48px)}}@keyframes fall{to{transform:rotate(65deg)}}@keyframes squish{30%{transform:translateY(6px) scale(1.1,.8)}65%{transform:translateY(-5px) scale(.94,1.07)}100%{transform:none}}@keyframes hop{35%{transform:translateY(-25px) rotate(-10deg)}65%{transform:translateY(0) scale(1.08,.9)}85%{transform:translateY(-6px) rotate(4deg)}100%{transform:none}}
@media(prefers-reduced-motion:reduce){.preview *{animation:none!important;transition:none!important;transform:none!important}}
</style>
