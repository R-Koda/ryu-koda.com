<details class="desk-memo">
  <summary>机のすみのメモ <span aria-hidden="true">↗</span></summary>
  <div><p>ここは、寄り道も実験のうち。</p><p>挨拶の文字、小物、引き出し。<br />気になったところに、そっと触れてみてください。</p><p class="secret-hint">おまけ：キーボードで <kbd>L</kbd> <kbd>A</kbd> <kbd>B</kbd> と打つと……。</p><button type="button" class="secret-trigger">合言葉を試してみる</button></div>
</details>
<div class="lab-secret" hidden role="status"><span class="stamp">寄り道、歓迎。</span><span>よく見つけました。ここも、らぼの一部です。</span><button type="button" aria-label="メッセージを閉じる">×</button></div>
<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const greeting = document.querySelector<HTMLButtonElement>('.greeting-play');
  let greetingBusy = false;
  greeting?.addEventListener('click', () => {
    if (greetingBusy || reduced.matches) return;
    greetingBusy = true;
    const letters = Array.from(greeting.querySelectorAll('i'));
    Promise.all(letters.map((letter, index) => letter.animate([
      { transform: 'translateY(0) rotate(0)' },
      { transform: `translateY(-${12 + index % 3 * 5}px) rotate(${index % 2 ? 7 : -7}deg)`, offset:.35 },
      { transform:'translateY(3px) rotate(0)',offset:.7 },
      { transform:'translateY(0) rotate(0)' }
    ], {duration:650, delay:index * 45, easing:'cubic-bezier(.2,.7,.3,1)'}).finished)).finally(() => greetingBusy = false);
  });
  // Pointer effects are decorative; anchors retain their native navigation.
  document.querySelectorAll<HTMLElement>('.journal-row,.starter-card').forEach(card => {
    let frame = 0, px = 0, py = 0;
    card.addEventListener('pointermove', e => {
      if (e.pointerType !== 'mouse' || reduced.matches) return;
      const r = card.getBoundingClientRect(); px = (e.clientX-r.left)/r.width-.5; py = (e.clientY-r.top)/r.height-.5;
      if (!frame) frame = requestAnimationFrame(() => {
        card.style.setProperty('--lean-x', `${-py * 3}deg`);
        card.style.setProperty('--lean-y', `${px * 3}deg`); frame = 0;
      });
    });
    const reset = () => { cancelAnimationFrame(frame); frame = 0; card.style.removeProperty('--lean-x'); card.style.removeProperty('--lean-y'); };
    card.addEventListener('pointerleave', reset); card.addEventListener('blur', reset); reduced.addEventListener('change', reset);
  });
  let lastBurst = 0;
  document.querySelectorAll<HTMLElement>('.drawer').forEach(drawer => {
    const burst = () => {
      if (reduced.matches || performance.now()-lastBurst<600) return;
      lastBurst=performance.now();
      const r=drawer.getBoundingClientRect();
      for(let i=0;i<7;i++) {
        const paper=document.createElement('span');
        paper.className='lab-paper'; paper.setAttribute('aria-hidden','true');
        paper.style.cssText=`left:${Math.min(innerWidth-12,r.right-35)}px;top:${Math.max(12,r.top+12)}px;background:${['#e4bf5a','#95b6a4','#a6b9d8','#c4acd9'][i%4]}`;
        document.body.append(paper);
        const dx=-15-i*10, dy=-24-(i%3)*15;
        paper.animate([{transform:'translate(0,0) rotate(0)',opacity:0},{transform:`translate(${dx}px,${dy}px) rotate(${i*35}deg)`,opacity:1,offset:.35},{transform:`translate(${dx*1.5}px,18px) rotate(${i*65}deg)`,opacity:0}],{duration:800,easing:'ease-out'}).finished.finally(()=>paper.remove());
      }
    };
    drawer.addEventListener('pointerenter', e => { if (e.pointerType==='mouse') burst(); });
    drawer.addEventListener('focusin', burst);
  });
  const secret = document.querySelector<HTMLElement>('.lab-secret')!;
  function reveal() { secret.hidden=false; }
  document.querySelector('.secret-trigger')?.addEventListener('click', reveal);
  secret.querySelector('button')!.addEventListener('click',()=>{secret.hidden=true;});
  let typed='', typedAt=0;
  document.addEventListener('keydown', e => {
    if(e.key==='Escape') { secret.hidden=true; typed=''; return; }
    const target=e.target as HTMLElement;
    if(e.ctrlKey||e.metaKey||e.altKey||e.isComposing||target.closest('input,textarea,select,[contenteditable="true"]')) return;
    if(performance.now()-typedAt>1500) typed='';
    typedAt=performance.now();
    if(e.key.length===1) typed=(typed+e.key.toLowerCase()).slice(-3);
    if(typed==='lab') { reveal(); typed=''; }
  });
</script>
<style>
  .desk-memo { margin:32px 0 0 auto; width:min(100%,350px); font-size:13px; border-bottom:1px dashed #b2aca0; }
  summary { padding:12px 0; cursor:pointer; color:#616159; }
  summary span { display:inline-block; margin-left:16px; transition:transform .2s; }
  details[open] summary span { transform:rotate(90deg); }
  .desk-memo > div { background:#fff8d9; border:1px solid #dfd2a5; padding:22px; margin:8px 0 18px; box-shadow:3px 4px 0 #ece8dc; border-radius:3px 8px 4px 3px; }
  p + p { margin-top:12px; } .secret-hint { font-size:11px; }
  kbd { border:1px solid #bcb69f; border-radius:3px; padding:1px 4px; background:white; }
  .secret-trigger { background:none; border:0; border-bottom:1px solid #8c815b; cursor:pointer; font-size:12px; padding:8px 0; margin-top:12px; }
  .lab-secret { position:fixed; bottom:24px; right:24px; z-index:100; width:min(340px,calc(100vw - 32px)); padding:22px 38px 22px 22px; background:#fffdf7; border:2px solid #354550; border-radius:8px 12px 9px 6px; box-shadow:4px 5px 0 #35455022; }
  .lab-secret[hidden] { display:none; }
  .lab-secret > span { display:block; font-size:12px; }
  .lab-secret .stamp { font-size:23px; color:#4b7260; border:2px solid #4b7260; display:inline-block; padding:3px 12px; transform:rotate(-4deg); margin-bottom:18px; font-family:'Yomogi Logo',sans-serif; }
  .lab-secret button { position:absolute; top:6px; right:6px; width:32px; height:32px; background:none; border:0; font-size:24px; cursor:pointer; }
  :global(.lab-paper) { position:fixed; width:6px; height:9px; border-radius:1px; pointer-events:none; z-index:99; }
  :global(.greeting-play) { font:inherit; color:inherit; border:0; background:none; padding:0; cursor:pointer; text-align:left; letter-spacing:inherit; }
  :global(.greeting-play i) { display:inline-block; font-style:normal; }
  :global(.greeting-play:hover) { color:#1d579b; }
  @media(hover:hover) and (prefers-reduced-motion:no-preference) {
    :global(.journal-row:hover), :global(.starter-card:hover) { transform:perspective(900px) rotateX(var(--lean-x,0deg)) rotateY(var(--lean-y,0deg)) translateY(-3px)!important; }
    :global(body:has(.desk-memo) .back-top:hover b) { animation:lift-off 700ms ease-in-out; }
    @keyframes lift-off { 0%,100%{transform:translateY(-3px)} 45%{transform:translateY(-13px) rotate(-7deg)} 70%{transform:translateY(1px)} }
  }
  @media(prefers-reduced-motion:reduce) { summary span { transition:none; } }
</style>
