---
import ActionLink from "./ActionLink.astro";
---

<footer>
  <div class="shell">
    <div class="footer-top">
      <p>
        また、ここで。
        <br />
        <em>Keep exploring.</em>
      </p>
      <ActionLink href="https://github.com/R-Koda" external variant="outline">
        GitHubで活動を見る
      </ActionLink>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Ryu Koda</span>
      <span>Technology, research & everyday life.</span>
      <a href="/rss.xml">RSS ↗</a>
    </div>
  </div>
</footer>
<style>
  footer {
    margin-top: 110px;
    background: #e8e9df;
    padding: 54px 0 24px;
  }
  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-bottom: 60px;
  }
  .footer-top p {
    font-family: var(--serif);
    font-size: 28px;
  }
  .footer-top em {
    font-size: 38px;
  }
  .footer-bottom {
    border-top: 1px solid #b8bcae;
    padding-top: 22px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-size: 11px;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    footer {
      margin-top: 70px;
    }
    .footer-top {
      align-items: start;
      flex-direction: column;
    }
    .footer-bottom {
      flex-wrap: wrap;
    }
    .footer-bottom span:nth-child(2) {
      display: none;
    }
  }
</style>
