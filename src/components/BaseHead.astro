---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { shouldIndex } from '../lib/seo.mjs';
import { SITE_TITLE, AUTHOR_NAME } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	socialImagePath?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	updatedTime?: Date;
	tags?: string[];
}

const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT ?? 'ca-pub-9235096476290205';
if (adsenseClient && !/^ca-pub-\d{16}$/.test(adsenseClient)) throw new Error('PUBLIC_ADSENSE_CLIENT must be a valid ca-pub ID');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image,
	socialImagePath,
	type = 'website',
	publishedTime,
	updatedTime,
	tags = [],
} = Astro.props;
const socialImage = new URL(socialImagePath ?? image?.src ?? '/social-card.png', Astro.site);
const indexable = shouldIndex(Astro.url.pathname);
const siteSchema = {
  '@context': 'https://schema.org', '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).href,
  name: SITE_TITLE, alternateName: 'ryu-koda.com', url: Astro.site?.href,
  inLanguage: 'ja',
};
const person = { '@type': 'Person', '@id': new URL('/about/#person', Astro.site).href, name: AUTHOR_NAME, url: new URL('/about/', Astro.site).href, image: new URL('/github-avatar.webp', Astro.site).href, sameAs: ['https://github.com/R-Koda'] };
const profileSchema = { '@context': 'https://schema.org', '@type': 'ProfilePage', url: canonicalURL.href, mainEntity: person };
---

<!-- Verification only: does not load advertising scripts. -->
{adsenseClient && <meta name="google-adsense-account" content={adsenseClient} />}
<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#ffffff" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
<link rel="icon" href="/favicon.ico" />
<link rel="manifest" href="/manifest.json" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="author" content={AUTHOR_NAME} />

<!-- Load only on the public site; exclude previews and local development. -->
<script is:inline>
  if (location.hostname === 'ryu-koda.com' && !document.querySelector('script[data-cf-beacon]')) {
    const beacon = document.createElement('script');
    beacon.type = 'module';
    beacon.src = 'https://static.cloudflareinsights.com/beacon.min.js';
    // Public analytics site token, not an API credential.
    beacon.dataset.cfBeacon = JSON.stringify({ token: '5f5b8a398c5443138132f293dc54f810' });
    document.head.append(beacon);
  }
</script>

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="ja_JP" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}
{publishedTime && <meta property="article:author" content={AUTHOR_NAME} />}
{type === 'article' && <meta property="article:section" content="Technology" />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImage} />

<meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, follow'} />
<meta property="og:image:width" content={image?.width ?? 1200} />
<meta property="og:image:height" content={image?.height ?? 630} />
<meta property="og:image:alt" content={image ? title : 'りゅうのらぼ — 開発・研究・日々の道具'} />
<meta name="twitter:image:alt" content={image ? title : 'りゅうのらぼ — 開発・研究・日々の道具'} />
{Astro.url.pathname === '/' && <script type="application/ld+json" set:html={JSON.stringify(siteSchema).replace(/</g, '\\u003c')} />}
{Astro.url.pathname === '/about/' && <script type="application/ld+json" set:html={JSON.stringify(profileSchema).replace(/</g, '\\u003c')} />}
