---
import { ADSENSE } from '../lib/adsense';
import { shouldIndex } from '../lib/seo.mjs';
const enabled = ADSENSE.enabled && shouldIndex(Astro.url.pathname);
---
{enabled && <aside class="ad-container" aria-label="Advertisement" translate="no">
  <span class="ad-label">Advertisement</span>
  <ins class="adsbygoogle" style="display:block" data-ad-client={ADSENSE.client}
    data-ad-slot={ADSENSE.articleEndSlot} data-ad-format="auto" data-full-width-responsive="true"></ins>
  <script is:inline define:vars={{client: ADSENSE.client}}>
    // Never request real ads on development or Cloudflare preview URLs.
    if (location.hostname === 'ryu-koda.com') {
      if (!document.querySelector('script[data-ryu-adsense]')) {
        const script = document.createElement('script');
        script.async = true;
        script.crossOrigin = 'anonymous';
        script.dataset.ryuAdsense = 'true';
        script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + client;
        document.head.append(script);
      }
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    }
  </script>
</aside>}
<style>
  .ad-container { width: 100%; margin: 2.5rem 0; border-top: 1px solid #e7e3dd; padding-top: 1rem; }
  .ad-label { display: block; text-align: center; font: 0.7rem/1.5 sans-serif; color: #777; margin-bottom: .6rem; }
  .adsbygoogle[data-ad-status="unfilled"] { display: none !important; }
</style>
