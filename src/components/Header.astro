---
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Home", ja: "ホーム" },
  { href: "/blog/", label: "Journal", ja: "ブログ" },
  { href: "/about/", label: "About", ja: "プロフィール" },
  { href: "/contact/", label: "Contact", ja: "お問い合わせ" },
];
---

<a class="skip-link" href="#main">
  本文へ移動
</a>
<header class="site-header">
  <nav class="shell top-nav" aria-label="メインナビゲーション">
    <a href="/" class="wordmark" aria-label="ホーム">
      <span class="handwritten-logo">りゅうのラボ</span>
    </a>
    <div class="nav-links">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={
            (l.href === "/" ? path === "/" : path.startsWith(l.href))
              ? "page"
              : undefined
          }
        >
          <span>{l.label}</span>
          <small>{l.ja}</small>
        </a>
      ))}
    </div>
  </nav>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #fffffff5;
    border-top: 3px solid var(--accent);
    border-bottom: 1px solid #e5e9ef;
    box-shadow: 0 3px 12px #243b5305;
    backdrop-filter: blur(12px);
  }
  .top-nav {
    height: 86px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }
  .nav-links {
    display: flex;
    gap: 8px;
  }
  .nav-links a {
    position: relative;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 54px;
    padding: 8px 17px;
    border-radius: 5px;
    font-size: 13px;
    transition:
      background 0.18s,
      color 0.18s;
  }
  .nav-links small {
    font-size: 9px;
    color: var(--muted);
    margin-top: 2px;
  }
  .nav-links a:hover {
    background: #f5f7fa;
  }
  .nav-links a[aria-current] {
    background: #eef3fa;
    color: var(--accent);
  }
  .nav-links a[aria-current]::after {
    content: "";
    position: absolute;
    height: 2px;
    left: 17px;
    right: 17px;
    bottom: 6px;
    background: var(--accent);
    border-radius: 2px;
  }
  @media (max-width: 760px) {
    .top-nav {
      height: 74px;
      gap: 8px;
    }
    .wordmark {
      font-size: 12px;
      gap: 7px;
    }
    .nav-links {
      gap: 2px;
    }
    .nav-links a {
      padding: 7px 8px;
      font-size: 12px;
    }
    .nav-links small {
      font-size: 8px;
    }
    .nav-links a[aria-current]::after {
      left: 8px;
      right: 8px;
    }
  }
  @media (max-width: 360px) {
    .wordmark > span:last-child {
      max-width: 48px;
      white-space: normal;
      line-height: 1.5;
    }
  }
  .profile-avatar {
    width: 36px;
    height: 36px;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid #e2e7ee;
    flex-shrink: 0;
  }
  @media (max-width: 760px) {
    .profile-avatar {
      width: 30px;
      height: 30px;
    }
  }
  @media (max-width: 760px) {
    .top-nav {
      height: auto;
      min-height: 112px;
      flex-wrap: wrap;
      padding-top: 12px;
      padding-bottom: 8px;
      gap: 6px;
    }
    .nav-links {
      width: 100%;
      justify-content: space-between;
    }
    .nav-links a {
      flex: 1;
      align-items: center;
    }
    .nav-links a[aria-current]::after {
      left: 20%;
      right: 20%;
    }
  }
  @font-face {
    font-family: "Yomogi Logo";
    src: url("/fonts/yomogi-logo.ttf") format("truetype");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  .wordmark .handwritten-logo {
    font-family: "Yomogi Logo", sans-serif;
    font-size: 27px;
    font-weight: 400;
    letter-spacing: 0.035em;
    line-height: 1.5;
    transform: rotate(-2deg);
    white-space: nowrap;
    max-width: none;
  }
  @media (max-width: 760px) {
    .wordmark .handwritten-logo {
      font-size: 25px;
      white-space: nowrap;
      max-width: none;
    }
  }
  /* Paper tabs on the edge of the toy box. */
  .site-header {
    border-top: 0;
    border-bottom: 2px solid #303d48;
    box-shadow: none;
    background: #fff;
  }
  .top-nav {
    align-items: center;
    height: 96px;
  }
  .wordmark {
    position: relative;
    padding: 0 8px;
  }
  .wordmark::after {
    content: "";
    position: absolute;
    left: 9px;
    right: 5px;
    bottom: 5px;
    height: 7px;
    background: #ffe493;
    z-index: -1;
    transform: rotate(-2deg);
    border-radius: 40% 25% 35% 20%;
  }
  .nav-links {
    gap: 12px;
  }
  .nav-links a {
    --tab: #eaf2ff;
    border: 1.5px solid #303d48;
    background: var(--tab);
    box-shadow: 2px 3px 0 #303d48;
    border-radius: 8px 8px 3px 3px;
    transform: rotate(-2deg);
    min-width: 90px;
    align-items: center;
    transition:
      transform 0.18s,
      box-shadow 0.18s;
  }
  .nav-links a:nth-child(2) {
    --tab: #fff0b8;
    transform: rotate(2deg);
  }
  .nav-links a:nth-child(3) {
    --tab: #fce3db;
    transform: rotate(-1deg);
  }
  .nav-links a:nth-child(4) {
    --tab: #e3f1e7;
    transform: rotate(2deg);
  }
  .nav-links a:hover {
    background: var(--tab);
    transform: translateY(-3px) rotate(0);
    box-shadow: 3px 5px 0 #303d48;
  }
  .nav-links a[aria-current] {
    background: var(--tab);
    color: #202f3e;
    box-shadow: 1px 1px 0 #303d48;
    transform: translateY(2px) rotate(0);
  }
  .nav-links a[aria-current]::after {
    height: 2px;
    background: #303d48;
    bottom: 6px;
  }
  .nav-links small {
    color: #4f5962;
  }
  @media (max-width: 760px) {
    .top-nav {
      height: auto;
      padding: 16px 0 12px;
      gap: 15px;
    }
    .nav-links {
      gap: 8px;
    }
    .nav-links a {
      min-width: 0;
      padding: 7px 4px;
      font-size: 12px;
    }
    .nav-links small {
      font-size: 8px;
    }
    .wordmark .handwritten-logo {
      font-size: 27px;
    }
  }
</style>
