---
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Home", ja: "ホーム" },
  { href: "/blog/", label: "Journal", ja: "ブログ" },
  { href: "/about/", label: "About", ja: "プロフィール" },
  { href: "/contact/", label: "Contact", ja: "お問い合わせ" },
];
---

<a class="skip-link" href="#main">
  本文へ移動
</a>
<header class="site-header">
  <nav class="shell top-nav" aria-label="メインナビゲーション">
    <a href="/" class="wordmark" aria-label="ホーム">
      <img
        class="profile-avatar"
        src="/github-avatar.webp"
        width="36"
        height="36"
        alt=""
      />
      <span>ノートと活動</span>
    </a>
    <div class="nav-links">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={
            (l.href === "/" ? path === "/" : path.startsWith(l.href))
              ? "page"
              : undefined
          }
        >
          <span>{l.label}</span>
          <small>{l.ja}</small>
        </a>
      ))}
    </div>
  </nav>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #fffffff5;
    border-top: 3px solid var(--accent);
    border-bottom: 1px solid #e5e9ef;
    box-shadow: 0 3px 12px #243b5305;
    backdrop-filter: blur(12px);
  }
  .top-nav {
    height: 86px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }
  .nav-links {
    display: flex;
    gap: 8px;
  }
  .nav-links a {
    position: relative;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 54px;
    padding: 8px 17px;
    border-radius: 5px;
    font-size: 13px;
    transition:
      background 0.18s,
      color 0.18s;
  }
  .nav-links small {
    font-size: 9px;
    color: var(--muted);
    margin-top: 2px;
  }
  .nav-links a:hover {
    background: #f5f7fa;
  }
  .nav-links a[aria-current] {
    background: #eef3fa;
    color: var(--accent);
  }
  .nav-links a[aria-current]::after {
    content: "";
    position: absolute;
    height: 2px;
    left: 17px;
    right: 17px;
    bottom: 6px;
    background: var(--accent);
    border-radius: 2px;
  }
  @media (max-width: 600px) {
    .top-nav {
      height: 74px;
      gap: 8px;
    }
    .wordmark {
      font-size: 12px;
      gap: 7px;
    }
    .nav-links {
      gap: 2px;
    }
    .nav-links a {
      padding: 7px 8px;
      font-size: 12px;
    }
    .nav-links small {
      font-size: 8px;
    }
    .nav-links a[aria-current]::after {
      left: 8px;
      right: 8px;
    }
  }
  @media (max-width: 360px) {
    .wordmark > span:last-child {
      max-width: 48px;
      white-space: normal;
      line-height: 1.5;
    }
  }
  .profile-avatar {
    width: 36px;
    height: 36px;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid #e2e7ee;
    flex-shrink: 0;
  }
  @media (max-width: 600px) {
    .profile-avatar {
      width: 30px;
      height: 30px;
    }
  }
  @media (max-width: 600px) {
    .top-nav {
      height: auto;
      min-height: 112px;
      flex-wrap: wrap;
      padding-top: 12px;
      padding-bottom: 8px;
      gap: 6px;
    }
    .nav-links {
      width: 100%;
      justify-content: space-between;
    }
    .nav-links a {
      flex: 1;
      align-items: center;
    }
    .nav-links a[aria-current]::after {
      left: 20%;
      right: 20%;
    }
  }
</style>
