---
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Home", ja: "ホーム" },
  { href: "/blog/", label: "Journal", ja: "ブログ" },
  { href: "/about/", label: "About", ja: "プロフィール" },
];
---

<a class="skip-link" href="#main">
  本文へ移動
</a>
<header class="site-header">
  <nav class="shell top-nav" aria-label="メインナビゲーション">
    <a href="/" class="wordmark" aria-label="Ryu Koda ホーム">
      Ryu Koda<span aria-hidden="true">.</span>
    </a>
    <div class="nav-links">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={
            (l.href === "/" ? path === "/" : path.startsWith(l.href))
              ? "page"
              : undefined
          }
        >
          <span>{l.label}</span>
          <small>{l.ja}</small>
        </a>
      ))}
    </div>
  </nav>
</header>
<style>
  .site-header {
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .top-nav {
    height: 80px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--line);
    gap: 28px;
  }
  .wordmark {
    font:
      700 22px/1.2 Atkinson,
      serif;
    letter-spacing: -0.8px;
    text-decoration: none;
    padding-right: 8px;
  }
  .wordmark span {
    color: var(--accent);
  }
  .header-note {
    font-size: 9px;
    letter-spacing: 0.12em;
    line-height: 1.6;
  }
  .nav-links {
    display: flex;
    margin-left: auto;
    gap: 36px;
  }
  .nav-links a {
    position: relative;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 56px;
    font-size: 14px;
  }
  .nav-links small {
    font-size: 9px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .nav-links a::after {
    content: "";
    height: 2px;
    position: absolute;
    bottom: 2px;
    left: 0;
    width: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s;
  }
  .nav-links a:hover::after,
  .nav-links a[aria-current]::after {
    transform: scaleX(1);
  }
  @media (max-width: 600px) {
    .top-nav {
      height: 72px;
      gap: 14px;
    }
    .header-note {
      display: none;
    }
    .nav-links {
      gap: 24px;
    }
    .wordmark {
      font-size: 20px;
    }
    .nav-links a {
      font-size: 13px;
    }
  }
</style>
