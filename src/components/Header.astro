---
const path = Astro.url.pathname;
const links = [
  { href: "/", label: "Home", ja: "ホーム" },
  { href: "/blog/", label: "Journal", ja: "ブログ" },
  { href: "/about/", label: "About", ja: "プロフィール" },
];
---

<a class="skip-link" href="#main">
  本文へ移動
</a>
<header class="site-header">
  <nav class="shell top-nav" aria-label="メインナビゲーション">
    <a href="/" class="wordmark" aria-label="ホーム">
      <span class="site-symbol" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path
            d="M6 4h9l4 4v12H6zM14 4v5h5M9 12h7M9 15h5"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"
          />
        </svg>
      </span>
      <span>ノートと活動</span>
    </a>
    <div class="nav-links">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={
            (l.href === "/" ? path === "/" : path.startsWith(l.href))
              ? "page"
              : undefined
          }
        >
          <span>{l.label}</span>
          <small>{l.ja}</small>
        </a>
      ))}
    </div>
  </nav>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #fffffff5;
    border-top: 3px solid var(--accent);
    border-bottom: 1px solid #e5e9ef;
    box-shadow: 0 3px 12px #243b5305;
    backdrop-filter: blur(12px);
  }
  .top-nav {
    height: 86px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }
  .site-symbol {
    width: 36px;
    height: 40px;
    border: 1px solid #bdcde2;
    border-radius: 5px;
    background: #f1f5fb;
    color: var(--accent);
    display: grid;
    place-items: center;
    box-shadow: 2px 2px 0 #e4ebf5;
  }
  .site-symbol svg {
    width: 25px;
    height: 25px;
  }
  .nav-links {
    display: flex;
    gap: 8px;
  }
  .nav-links a {
    position: relative;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 54px;
    padding: 8px 17px;
    border-radius: 5px;
    font-size: 13px;
    transition:
      background 0.18s,
      color 0.18s;
  }
  .nav-links small {
    font-size: 9px;
    color: var(--muted);
    margin-top: 2px;
  }
  .nav-links a:hover {
    background: #f5f7fa;
  }
  .nav-links a[aria-current] {
    background: #eef3fa;
    color: var(--accent);
  }
  .nav-links a[aria-current]::after {
    content: "";
    position: absolute;
    height: 2px;
    left: 17px;
    right: 17px;
    bottom: 6px;
    background: var(--accent);
    border-radius: 2px;
  }
  @media (max-width: 600px) {
    .top-nav {
      height: 74px;
      gap: 8px;
    }
    .wordmark {
      font-size: 12px;
      gap: 7px;
    }
    .site-symbol {
      width: 27px;
      height: 32px;
    }
    .site-symbol svg {
      width: 21px;
    }
    .nav-links {
      gap: 2px;
    }
    .nav-links a {
      padding: 7px 8px;
      font-size: 12px;
    }
    .nav-links small {
      font-size: 8px;
    }
    .nav-links a[aria-current]::after {
      left: 8px;
      right: 8px;
    }
  }
  @media (max-width: 360px) {
    .wordmark > span:last-child {
      max-width: 48px;
      white-space: normal;
      line-height: 1.5;
    }
  }
</style>
