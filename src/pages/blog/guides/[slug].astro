---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FollowNote from '../../../components/FollowNote.astro';
import {readingGuides} from '../../../data/reading-guides';
import {journalPosts} from '../../../lib/posts';
export function getStaticPaths(){return readingGuides.map(guide=>({params:{slug:guide.slug},props:{guide}}));}
const {guide}=Astro.props;
const posts=await journalPosts();
const cards=guide.items.map(item=>({...item,post:posts.find(p=>p.id===item.slug)!}));
if(cards.some(c=>!c.post)) throw new Error('Reading guide points to missing article');
const schema={'@context':'https://schema.org','@type':'CollectionPage',name:guide.title,description:guide.description,url:new URL(Astro.url.pathname,Astro.site).href,mainEntity:{'@type':'ItemList',itemListElement:cards.map((c,i)=>({'@type':'ListItem',position:i+1,url:new URL(`/blog/${c.slug}/`,Astro.site).href,name:c.post.data.title}))}};
---
<!doctype html><html lang="ja"><head><BaseHead title={`${guide.title} | りゅうのらぼ`} description={guide.description}/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/></head>
<body><Header/><main id="main" class="shell reading-guide"><nav aria-label="パンくずリスト"><a href="/">ホーム</a> / <a href="/blog/">ブログ</a> / 目的から読む</nav><p class="eyebrow">どこから読もう？</p><h1>{guide.title}</h1><p class="intro">{guide.intro}</p><section aria-labelledby="choose"><h2 id="choose">いま、試したいことから。</h2><div class="cards">{cards.map(c=><article><a href={`/blog/${c.slug}/`}>{c.post.data.heroImage && <img src={c.post.data.heroImage.src} alt="" width="1200" height="630" loading="lazy"/>}<h3>{c.post.data.title}</h3></a><p>{c.reason}</p></article>)}</div></section><section class="note"><h2>試す前に、ここだけ。</h2><p>{guide.note}</p></section><p><a href="/blog/">ほかの記事も見てみる →</a></p><FollowNote/></main><Footer/></body></html>
<style>
.reading-guide{max-width:960px;padding-top:30px;}nav,.eyebrow{font-size:13px;color:#58636a;}h1{font-size:clamp(25px,4vw,36px);line-height:1.55;margin:18px 0;}h2{font-size:22px;margin:34px 0 20px;}h3{font-size:19px;line-height:1.65;margin:16px 0;}p{font-size:15px;line-height:2;} .intro{max-width:760px;margin-bottom:35px;}a{text-underline-offset:5px;}a:hover{color:#245b89;}a:focus-visible{outline:3px solid #315f91;outline-offset:5px;}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;}article{border:1px solid #d7dce0;border-radius:10px;overflow:hidden;padding:18px;}article img{width:100%;height:auto;aspect-ratio:1200/630;object-fit:cover;border-radius:5px;}.note{background:#f4f7ee;padding:20px 25px;margin:32px 0;border-radius:10px;}.note h2{margin:0 0 12px;}@media(max-width:600px){.cards{grid-template-columns:1fr;}article{padding:14px;}}
</style>
