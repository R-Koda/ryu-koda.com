---
import { thumbnailAttrs } from "../../lib/thumbnails";
import { readingGuides } from "../../data/reading-guides";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { journalPosts } from "../../lib/posts";
import guides from "../../data/article-guides.json";
import starters from "../../data/starter-articles.json";
import FollowNote from "../../components/FollowNote.astro";
import ExperimentPreview from "../../components/ExperimentPreview.astro";
import { experiments } from "../../data/experiments";
import { guides as experimentGuides } from "../../data/experiment-guides";
import { categoryFor } from "../../lib/categories";
const posts = await journalPosts();
const entries = [
  ...posts.map(p => ({kind: 'blog', id: p.id, href: `/blog/${p.id}/`, data: p.data, date: p.data.updatedDate ?? p.data.pubDate, preview: '', color: ''})),
  ...experiments.map(e => ({kind: 'lab', id: e.slug, href: `/playground/${e.slug}/`, data: {title: experimentGuides[e.slug].seoTitle, description: experimentGuides[e.slug].description, tags: ['Web制作'], heroImage: undefined}, date: new Date(e.updatedAt), preview: e.slug, color: e.color})),
].sort((a,b) => b.date.valueOf() - a.date.valueOf() || a.href.localeCompare(b.href));
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead
      title="ブログ | りゅうのらぼ"
      description="AI、アプリ、小さな自動化、ガジェット。日々を少し便利にする道具とアイデアの記録。"
    />
  </head>
  <body>
    <Header />
    <main id="main" class="shell journal">
      <span class="eyebrow">BLOG</span>
      <div class="journal-heading">
        <h1>ブログ</h1>
        <p>
          AI、アプリ、小さな自動化。
          <br />
          気になったことを、ひとつずつ。
        </p>
      </div>
      <nav class="reading-entrances" aria-label="目的から記事を探す"><span>目的から読む：</span>{readingGuides.map(g => <a href={`/blog/guides/${g.slug}/`}>{g.label} ↗</a>)}</nav>
      <p class="reading-entrances">ブログとWebの実験室を、更新が新しい順に。動くデモもここから探せます。</p>
      <div class="filter-bar">
        <div class="tags" role="group" aria-label="記事の分類">
          {[['', 'すべて'], ['blog', 'ブログ'], ['lab', 'Webの実験室']].map(([kind, label]) => (
            <button type="button" class="tag" data-kind-filter={kind} aria-pressed={kind === '' ? 'true' : 'false'}>
              {label} <sup>{kind ? entries.filter(e => e.kind === kind).length : entries.length}</sup>
            </button>
          ))}
        </div>
        <label class="search">
          <span class="sr-only">記事を検索</span>
          <input id="post-search" type="search" placeholder="記事を探す" />
          <span aria-hidden="true">⌕</span>
        </label>
      </div>
      <p id="result-count" aria-live="polite">
        {entries.length}件の記事
      </p>
      <div class="articles">
        {entries.map((p) => (
          <article
            data-title={`${p.data.title} ${p.data.description}`}
            data-kind={p.kind}
          >
            <a href={p.href} class:list={[{kit: p.kind === "lab"}]}>
              {p.kind === "lab" && <div class="lab-preview" style={`background:${p.color}`}><ExperimentPreview kind={p.preview} /></div>}
              {guides[p.id as keyof typeof guides] && !p.data.heroImage && <img class="post-preview" src={`/articles/${p.id}/cover.webp`} alt={guides[p.id as keyof typeof guides].label} width="1200" height="630" loading="lazy" decoding="async" />}
              {starters.find(s => s.slug === p.id) && <img class="post-preview" {...thumbnailAttrs(p.id,starters.find(s => s.slug === p.id)!.image,"(max-width: 600px) 100vw, 180px")} alt={starters.find(s => s.slug === p.id)!.imageAlt} width="1200" height="630" loading="lazy" decoding="async" />}
              {!starters.some(s => s.slug === p.id) && p.data.heroImage && <img class="post-preview" {...thumbnailAttrs(p.id,p.data.heroImage.src,"(max-width: 600px) 100vw, 180px")} alt="" width={p.data.heroImage.width} height={p.data.heroImage.height} loading="lazy" decoding="async" />}
              <div class="article-body">
              <div class="article-meta">
                <span>{p.kind === "lab" ? "Webの実験室" : categoryFor(p.data.tags)}</span>
                {p.kind === "lab" && <span class="demo-badge">動くデモ付き</span>}
                <FormattedDate date={p.date} />
              </div>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
              <span class="read-link">
                {p.kind === "lab" ? "デモと作り方を見る" : "記事を読む"} <span aria-hidden="true">↗</span>
              </span>
              </div>
            </a>
          </article>
        ))}
      </div>
      <div id="no-results" hidden>
        <p>一致する記事が見つかりませんでした。</p>
        <button type="button" id="clear-search" class="tag">
          検索と絞り込みを解除 ↗
        </button>
      </div>
      <FollowNote />
    </main>
    <Footer />
  </body>
</html>
<script>
  const search = document.querySelector<HTMLInputElement>("#post-search");
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-kind-filter]");
  const articles = document.querySelectorAll<HTMLElement>(
    "article[data-title]",
  );
  let selected = "";
  function filter() {
    let count = 0;
    const query = (search?.value || "").trim().normalize("NFKC").toLocaleLowerCase();
    articles.forEach((a) => {

      const show =
        (!selected || a.dataset.kind === selected) &&
        (a.querySelector(".article-body")?.textContent || "").normalize("NFKC").toLocaleLowerCase().includes(query);
      a.hidden = !show;
      if (show) count++;
    });
    const result = document.getElementById("result-count");
    if (result) {
      const language = document.documentElement.lang;
      result.textContent = language.startsWith('en') ? `${count} ${count === 1 ? "article" : "articles"}` : language.startsWith('zh') ? `${count} 篇文章` : `${count}件の記事`;
    }
    const empty = document.getElementById("no-results");
    if (empty) empty.hidden = count > 0;
    buttons.forEach((b) =>
      b.setAttribute("aria-pressed", String(b.dataset.kindFilter === selected)),
    );
  }
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      selected = b.dataset.kindFilter || "";
      filter();
    }),
  );
  search?.addEventListener("input", filter);
  document.getElementById("clear-search")?.addEventListener("click", () => {
    selected = "";
    if (search) {
      search.value = "";
      search.focus();
    }
    filter();
  });
</script>
<style>
  .lab-preview { width: 180px; border: 1px solid #d6dce3; border-radius: 7px; overflow: hidden; }
  .lab-preview :global(.preview) { margin: 0; height: 110px; }
  .demo-badge { background: #e1eee5; color: #284f3e; padding: 3px 8px; border-radius: 4px; font-weight: 700; }
  .article-meta { flex-wrap: wrap; gap: 8px; align-items: center; }
  .articles a:focus-visible { outline: 3px solid #245b89; outline-offset: 5px; border-radius: 7px; }
  @media(max-width:600px) { .lab-preview { width: 100%; max-width: 360px; } .lab-preview :global(.preview) { height: 160px; } }
  .post-preview { width: 180px; height: auto; margin: 0; border-radius: 7px; border: 1px solid #d6dce3; }
  .articles article { display: flow-root; }
  .articles article[hidden] { display: none; }
  @media(max-width:600px) { .post-preview { width: 100%; max-width: 360px; } }

  .journal {
    padding-top: 60px;
  }
  .journal-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 30px;
    margin: 26px 0 55px;
  }
  .journal h1 {
    font: clamp(45px, 7vw, 86px)/1.4 var(--serif);
  }
  .journal h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .journal-heading p {
    font-size: 14px;
    line-height: 2;
    color: var(--muted);
  }
  .filter-bar {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line);
    align-items: center;
  }
  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tag {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line);
    cursor: pointer;
    padding: 8px 16px;
    font-size: 12px;
    min-height: 44px;
    transition:
      background 0.2s,
      color 0.2s,
      transform 0.15s;
  }
  .tag:hover {
    border-color: var(--ink);
    background: #e5e7dc;
  }
  .tag[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .tag:active {
    transform: translateY(2px);
  }
  .tag sup {
    margin-left: 8px;
  }
  .search {
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--ink);
    min-width: 180px;
  }
  .search input {
    width: 170px;
    border: none;
    background: transparent;
    padding: 10px;
    font-size: 13px;
    min-height: 44px;
    color: var(--ink);
  }
  #result-count {
    font-size: 11px;
    color: var(--muted);
    margin: 18px 0 30px;
  }
  .articles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px 36px;
  }
  .articles a {
    text-decoration: none;
  }
  .article-cover {
    aspect-ratio: 1.6;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 26px;
    transition: transform 0.3s;
  }
  .cover-clay {
    background: #ded0bc;
  }
  .cover-moss {
    background: #d9dfce;
  }
  .cover-label,
  .cover-bottom {
    font-size: 9px;
    letter-spacing: 0.12em;
  }
  .cover-type {
    font: clamp(45px, 6vw, 80px)/0.9 var(--serif);
    letter-spacing: -0.05em;
  }
  .cover-type i {
    display: block;
    margin-left: 45px;
  }
  .cover-bottom {
    display: flex;
    justify-content: space-between;
  }
  .cover-bottom b {
    font-size: 22px;
    font-weight: 400;
    transition: transform 0.2s;
  }
  .articles a:hover .cover-bottom b {
    transform: translate(3px, -3px);
  }
  .article-meta {
    display: flex;
    justify-content: space-between;
    margin: 22px 0 12px;
    font-size: 10px;
    color: var(--muted);
  }
  .articles h2 {
    font-size: 20px;
    line-height: 1.7;
    word-break: auto-phrase;
    overflow-wrap: break-word;
    text-wrap: pretty;
  }
  .articles p {
    font-size: 13px;
    color: var(--muted);
    margin-top: 14px;
    line-height: 1.9;
  }
  .read-link {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    font-size: 12px;
    margin-top: 18px;
  }
  .articles a:hover .read-link {
    border-color: var(--accent);
  }
  #no-results {
    padding: 60px 0;
  }
  #no-results button {
    margin-top: 20px;
  }
  @media (max-width: 760px) {
    .journal {
      padding-top: 35px;
    }
    .journal-heading {
      display: block;
      margin-bottom: 30px;
    }
    .journal-heading p {
      margin-top: 24px;
    }
    .filter-bar {
      align-items: stretch;
      flex-direction: column;
    }
    .search input {
      width: 100%;
    }
    .articles {
      grid-template-columns: 1fr;
    }
    .article-cover {
      aspect-ratio: 1.5;
    }
    .cover-type {
      font-size: 64px;
    }
  }
  .articles {
    grid-template-columns: 1fr;
    gap: 0;
  }
  .articles article {
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .articles a {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }
  .article-meta {
    margin-top: 0;
  }
  .read-link {
    border: 0;
    justify-content: flex-start;
    gap: 24px;
    margin-top: 4px;
  }
  .journal h1 {
    font-family: inherit;
    font-size: 44px;
    font-weight: 700;
  }
  .journal-heading {
    margin-bottom: 35px;
  }
  .tag {
    border-radius: 4px;
  }
  .tag:hover {
    background: #f5f7fa;
  }
  .article-body { min-width: 0; }
  @media(max-width:600px) { .articles a { grid-template-columns: minmax(0, 1fr); gap: 18px; } }
</style>

<style>.reading-entrances{display:flex;flex-wrap:wrap;gap:10px 20px;margin:0 0 26px;font-size:13px;line-height:1.9;}.reading-entrances a{text-underline-offset:4px;}.reading-entrances a:hover{color:#245b89;}</style>
