---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { journalPosts } from "../../lib/posts";
const posts = await journalPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags || []))];
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead
      title="Journal — Ryu Koda"
      description="AI、アプリ、小さな自動化、ガジェット。日々を少し便利にする道具とアイデアの記録。"
    />
  </head>
  <body>
    <Header />
    <main id="main" class="shell journal">
      <span class="eyebrow">RYU KODA / BLOG</span>
      <div class="journal-heading">
        <h1>ブログ</h1>
        <p>
          AI、アプリ、小さな自動化。
          <br />
          気になったことを、ひとつずつ。
        </p>
      </div>
      <div class="filter-bar">
        <div class="tags" role="group" aria-label="記事の分類">
          <button type="button" class="tag" data-tag="" aria-pressed="true">
            すべて <sup>{posts.length}</sup>
          </button>
          {tags.map((t) => (
            <button type="button" class="tag" data-tag={t} aria-pressed="false">
              {t}
            </button>
          ))}
        </div>
        <label class="search">
          <span class="sr-only">記事を検索</span>
          <input id="post-search" type="search" placeholder="記事を探す" />
          <span aria-hidden="true">⌕</span>
        </label>
      </div>
      <p id="result-count" aria-live="polite">
        {posts.length} articles
      </p>
      <div class="articles">
        {posts.map((p, i) => (
          <article
            data-title={`${p.data.title} ${p.data.description}`}
            data-tags={JSON.stringify(p.data.tags || [])}
          >
            <a href={`/blog/${p.id}/`}>
              <div class="article-meta">
                <span>{p.data.tags?.[0] || "TECHNOLOGY"}</span>
                <FormattedDate date={p.data.pubDate} />
              </div>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
              <span class="read-link">
                記事を読む <span aria-hidden="true">↗</span>
              </span>
            </a>
          </article>
        ))}
      </div>
      <div id="no-results" hidden>
        <p>一致する記事が見つかりませんでした。</p>
        <button type="button" id="clear-search" class="tag">
          検索と絞り込みを解除 ↗
        </button>
      </div>
    </main>
    <Footer />
  </body>
</html>
<script>
  const search = document.querySelector<HTMLInputElement>("#post-search");
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-tag]");
  const articles = document.querySelectorAll<HTMLElement>(
    "article[data-title]",
  );
  let selected = "";
  function filter() {
    let count = 0;
    const query = (search?.value || "").trim().toLocaleLowerCase();
    articles.forEach((a) => {
      const tags = JSON.parse(a.dataset.tags || "[]");
      const show =
        (!selected || tags.includes(selected)) &&
        (a.dataset.title || "").toLocaleLowerCase().includes(query);
      a.hidden = !show;
      if (show) count++;
    });
    const result = document.getElementById("result-count");
    if (result) result.textContent = `${count} articles`;
    const empty = document.getElementById("no-results");
    if (empty) empty.hidden = count > 0;
    buttons.forEach((b) =>
      b.setAttribute("aria-pressed", String(b.dataset.tag === selected)),
    );
  }
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      selected = b.dataset.tag || "";
      filter();
    }),
  );
  search?.addEventListener("input", filter);
  document.getElementById("clear-search")?.addEventListener("click", () => {
    selected = "";
    if (search) {
      search.value = "";
      search.focus();
    }
    filter();
  });
</script>
<style>
  .journal {
    padding-top: 60px;
  }
  .journal-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 30px;
    margin: 26px 0 55px;
  }
  .journal h1 {
    font: clamp(45px, 7vw, 86px)/1.4 var(--serif);
  }
  .journal h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .journal-heading p {
    font-size: 14px;
    line-height: 2;
    color: var(--muted);
  }
  .filter-bar {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--line);
    align-items: center;
  }
  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tag {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line);
    cursor: pointer;
    padding: 8px 16px;
    font-size: 12px;
    min-height: 44px;
    transition:
      background 0.2s,
      color 0.2s,
      transform 0.15s;
  }
  .tag:hover {
    border-color: var(--ink);
    background: #e5e7dc;
  }
  .tag[aria-pressed="true"] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .tag:active {
    transform: translateY(2px);
  }
  .tag sup {
    margin-left: 8px;
  }
  .search {
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--ink);
    min-width: 180px;
  }
  .search input {
    width: 170px;
    border: none;
    background: transparent;
    padding: 10px;
    font-size: 13px;
    min-height: 44px;
    color: var(--ink);
  }
  #result-count {
    font-size: 11px;
    color: var(--muted);
    margin: 18px 0 30px;
  }
  .articles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px 36px;
  }
  .articles a {
    text-decoration: none;
  }
  .article-cover {
    aspect-ratio: 1.6;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 26px;
    transition: transform 0.3s;
  }
  .cover-clay {
    background: #ded0bc;
  }
  .cover-moss {
    background: #d9dfce;
  }
  .cover-label,
  .cover-bottom {
    font-size: 9px;
    letter-spacing: 0.12em;
  }
  .cover-type {
    font: clamp(45px, 6vw, 80px)/0.9 var(--serif);
    letter-spacing: -0.05em;
  }
  .cover-type i {
    display: block;
    margin-left: 45px;
  }
  .cover-bottom {
    display: flex;
    justify-content: space-between;
  }
  .cover-bottom b {
    font-size: 22px;
    font-weight: 400;
    transition: transform 0.2s;
  }
  .articles a:hover .cover-bottom b {
    transform: translate(3px, -3px);
  }
  .article-meta {
    display: flex;
    justify-content: space-between;
    margin: 22px 0 12px;
    font-size: 10px;
    color: var(--muted);
  }
  .articles h2 {
    font-size: 21px;
    line-height: 1.7;
  }
  .articles p {
    font-size: 13px;
    color: var(--muted);
    margin-top: 14px;
    line-height: 1.9;
  }
  .read-link {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    font-size: 12px;
    margin-top: 18px;
  }
  .articles a:hover .read-link {
    border-color: var(--accent);
  }
  #no-results {
    padding: 60px 0;
  }
  #no-results button {
    margin-top: 20px;
  }
  @media (max-width: 760px) {
    .journal {
      padding-top: 35px;
    }
    .journal-heading {
      display: block;
      margin-bottom: 30px;
    }
    .journal-heading p {
      margin-top: 24px;
    }
    .filter-bar {
      align-items: stretch;
      flex-direction: column;
    }
    .search input {
      width: 100%;
    }
    .articles {
      grid-template-columns: 1fr;
    }
    .article-cover {
      aspect-ratio: 1.5;
    }
    .cover-type {
      font-size: 64px;
    }
  }
  .articles {
    grid-template-columns: 1fr;
    gap: 0;
  }
  .articles article {
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .articles a {
    display: block;
    max-width: 820px;
  }
  .article-meta {
    margin-top: 0;
  }
  .read-link {
    border: 0;
    justify-content: flex-start;
    gap: 24px;
    margin-top: 4px;
  }
  .journal h1 {
    font-family: inherit;
    font-size: 44px;
    font-weight: 700;
  }
  .journal-heading {
    margin-bottom: 35px;
  }
  .tag {
    border-radius: 4px;
  }
  .tag:hover {
    background: #f5f7fa;
  }
</style>
