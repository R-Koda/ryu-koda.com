---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ActionLink from '../../../components/ActionLink.astro';
import research from '../../../data/research.json';
export function getStaticPaths() {
  return research.map(item => ({params:{slug:item.slug},props:{item}}));
}
const {item} = Astro.props;
const others = research.filter(r => r.slug !== item.slug);
---
<!doctype html>
<html lang="ja">
<head><BaseHead title={`${item.name}での研究・活動 | りゅうのらぼ`} description={`${item.name}での${item.role}としての活動。${item.sinceLabel}から継続中。所属・役職と研究室の概要を紹介します。`} /></head>
<body><Header />
<main id="main" class="shell research-detail">
<nav class="breadcrumbs" aria-label="パンくずリスト"><a href="/">ホーム</a><span>/</span><a href="/work/">お仕事</a><span>/</span><a href="/work/#research">研究</a><span>/</span><span>{item.name}</span></nav>
<header class="identity"><div class="logo-box" style={`background:${item.iconBackground}`}><img src={item.icon} alt={item.iconAlt} width="168" height="112" /></div><div><p class="eyebrow">RESEARCH</p><h1>{item.name}</h1><p class="subtitle">{item.subtitle}</p></div></header>
<section class="role-card" aria-labelledby="role-title"><h2 id="role-title">所属・役職</h2><p class="role">{item.role}</p><p><time datetime={item.since}>{item.sinceLabel}</time>〜現在</p><p>{item.personal}</p></section>
<section class="overview" aria-labelledby="overview-title"><h2 id="overview-title">研究室について</h2><p>{item.overview}</p><ul class="themes" aria-label="研究室が扱うテーマ">{item.themes.map(theme=><li>{theme}</li>)}</ul><p class="source-note">ここでは研究室全体の研究分野を紹介しています。</p><ActionLink href={item.official} external variant="outline">{item.officialLabel}</ActionLink>{item.additional && <p><a href={item.additional} target="_blank" rel="noopener noreferrer">{item.additionalLabel} ↗</a></p>}</section>
<section class="sources" aria-labelledby="sources-title"><h2 id="sources-title">掲載情報について</h2><p>所属・役職・在籍期間は<a href="https://www.linkedin.com/in/ryu-koda/" target="_blank" rel="noopener noreferrer">LinkedInプロフィール</a>の継続中の職歴を確認して掲載しています（2026年11月4日確認）。研究室の概要・ロゴは上記公式サイトに基づきます（2026年11月5日確認）。このページは、りゅうのらぼ運営者の活動紹介です。</p></section>
<nav class="other-research" aria-label="ほかの研究活動"><h2>ほかの研究活動</h2>{others.map(r=><a href={`/work/research/${r.slug}/`}>{r.name} <span aria-hidden="true">→</span></a>)}</nav>
<ActionLink href="/work/#research" variant="text">研究一覧に戻る</ActionLink>
</main><Footer /></body></html>
<style>
.research-detail{max-width:960px;padding-top:35px}.breadcrumbs{display:flex;flex-wrap:wrap;gap:10px;font-size:12px;line-height:1.8;color:var(--muted);margin-bottom:32px}.identity{display:flex;gap:28px;align-items:center;margin-bottom:32px}.logo-box{width:192px;min-width:192px;height:136px;padding:12px;border:1px solid #d7dfd9;border-radius:12px;display:grid;place-items:center}.logo-box img{width:100%;height:100%;object-fit:contain}.eyebrow{font-size:12px;color:var(--muted);margin:0 0 8px}h1{font-size:clamp(25px,4vw,35px);line-height:1.5;margin:0 0 10px}.subtitle{font-size:14px;line-height:1.8;color:var(--muted);margin:0}h2{font-size:21px;margin:0 0 18px}section{margin:32px 0}section p{font-size:14px;line-height:2}.role-card{border:1.5px solid #34434d;border-top:6px solid #c3dac4;padding:26px;border-radius:9px;box-shadow:4px 4px 0 #e8eee7}.role-card .role{font-size:19px;font-weight:700}.overview{padding:20px 0}.themes{list-style:none;display:flex;gap:10px;flex-wrap:wrap;padding:0;margin:20px 0}.themes li{background:#edf4ec;border:1px solid #cedbce;border-radius:5px;padding:6px 12px;font-size:13px}.source-note{color:var(--muted);font-size:12px!important}.sources{border-top:1px dashed #bac5bd;padding-top:24px}.sources h2{font-size:17px}.sources p{font-size:12px;color:var(--muted)}.other-research{margin:40px 0}.other-research h2{font-size:18px}.other-research a{display:flex;justify-content:space-between;padding:16px 0;border-bottom:1px solid #d9e0da;text-underline-offset:5px;font-size:14px}@media(max-width:600px){.identity{align-items:flex-start;flex-direction:column;gap:18px}.logo-box{width:160px;min-width:160px;height:108px}.role-card{padding:20px}.breadcrumbs{font-size:11px}}
</style>
