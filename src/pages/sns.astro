---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ActionLink from "../components/ActionLink.astro";
---
<!doctype html>
<html lang="ja">
  <head><BaseHead title="SNS・発信 | りゅうのらぼ" description="りゅうのらぼとしてのSNSを準備中です。アカウントの開設後、このページでお知らせします。" /></head>
  <body>
    <Header />
    <main id="main" class="shell sns-page">
      <p class="eyebrow">SNS</p>
      <h1>SNSのひきだし</h1>
      <p class="lead">りゅうのらぼの日々を、SNSでも。</p>
      <section class="preparing">
        <span class="badge">準備中</span>
        <h2>ただいま、発信の場所をつくっています。</h2>
        <p>「りゅうのらぼ」として、新しくSNSを始める予定です。<br />アカウントができたら、こちらにリンクを掲載します。</p>
        <ActionLink href="/blog/" variant="outline">それまでは、ブログをどうぞ</ActionLink>
      </section>
    </main>
    <Footer />
  </body>
</html>
<style>
  .sns-page { padding-top: 50px; max-width: 960px; }
  .eyebrow, .lead { color: var(--muted); }
  h1 { display: inline-block; font-size: 32px; margin: 18px 0 22px; background: linear-gradient(transparent 75%, #eee0ff 75%); transform: rotate(-1deg); }
  .lead { font-size: 15px; margin-bottom: 36px; }
  .preparing { position: relative; padding: 36px; background: #fffdf7; border: 1.5px solid #303d48; border-radius: 6px 12px 5px 8px; box-shadow: 5px 6px 0 #e8e4ee; }
  .preparing::before { content: ""; position: absolute; top: -9px; right: 25px; width: 65px; height: 17px; background: #eee5fa; border: 1px solid #303d4820; transform: rotate(5deg); }
  .badge { display: inline-block; padding: 3px 12px; background: #eee5fa; border-radius: 3px; font-size: 12px; }
  h2 { font-size: 21px; line-height: 1.7; margin: 18px 0; }
  .preparing p { font-size: 14px; line-height: 2; color: var(--muted); margin-bottom: 26px; }
  @media (max-width: 600px) { .sns-page { padding-top: 32px; } .preparing { padding: 26px 22px; } h1 { font-size: 28px; } }
</style>
