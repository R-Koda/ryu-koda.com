---
import ExperimentPreview from '../components/ExperimentPreview.astro';
import ShareLinks from "../components/ShareLinks.astro";
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { experiments } from '../data/experiments';
import { guides } from '../data/experiment-guides';
import LabDetails from '../components/LabDetails.astro';
import LabToys from '../components/LabToys.astro';
---
<!doctype html>
<html lang="ja">
  <head><BaseHead title="Webの実験室｜CSS・JavaScriptの動くデモと作り方 | りゅうのらぼ" description="CSS・JavaScript・SVGで作る、触れるWebの実験室。ぷにぷにボタン、文字の物理演算、配線パズルなど、動くデモと実装コード、手元で再現する方法を紹介します。" /></head>
  <body>
    <Header />
    <main id="main" class="shell playground" data-toy-lab data-bounce="65">
      <a class="back" href="/">← らぼに戻る</a>
      <p class="eyebrow">PLAY WITH THE CODE</p>
      <h1>Webの実験室</h1>
      <p class="lead">触って楽しい。作ってわかる。<br />サイトを華やかにするアイデアと、作り方。CSS・JavaScript・SVGで、画面に遊び心を。</p>
      <p>それぞれのページで「動くデモ → 試し方 → 手元で動かす → 仕組み → 変えてみる」の順に紹介します。HTML・CSSの基本がわかり、JavaScriptの動きを試してみたい方へ。</p>
      <nav class="kit-grid" aria-label="実験を選ぶ">{experiments.map(e=><a class="kit" href={`/playground/${e.slug}/`} style={`--kit-color:${e.color}`}><span>KIT {e.number} / {e.verb}</span><ExperimentPreview kind={e.slug} /><strong>{guides[e.slug].seoTitle}</strong><p>{guides[e.slug].description}</p><b>デモと作り方を見る ↗</b></a>)}</nav>
      <LabDetails />
      <h2 class="first-kit">JavaScriptで、つまんで投げる物理演算UIを試す。</h2>
      <div class="workbench">
        <section class="stage" aria-labelledby="stage-title">
          <div class="stage-top"><h2 id="stage-title">今日のお題：机の上の小物</h2><span>01 / つまむ</span></div>
          <div class="desk"><LabToys position="bottom" /></div>
          <p class="stage-hint">上下左右につまんで、ぽいっ。<br />離すと落ちて、床でぽんぽん跳ねます。</p>
          <p class="keyboard-help">キーボードでも：Tabで選ぶ → 矢印キー / Enterで遊ぶ</p>
        </section>
        <section class="controls" aria-labelledby="controls-title">
          <h2 id="controls-title">動きのレシピ</h2>
          <label for="bounce">弾み方 <output id="bounce-value" for="bounce">65</output></label>
          <input id="bounce" type="range" min="0" max="100" value="65" />
          <div class="range-labels"><span>ずしっと</span><span>ぽよんぽよん</span></div>
          <fieldset><legend>パソコンの色</legend><div class="swatches">
            <label style="--swatch:#e3eee6"><input type="radio" name="toy-color" value="#e3eee6" checked /><span>ミント</span></label>
            <label style="--swatch:#ffe9ac"><input type="radio" name="toy-color" value="#ffe9ac" /><span>バター</span></label>
            <label style="--swatch:#eadff5"><input type="radio" name="toy-color" value="#eadff5" /><span>ライラック</span></label>
          </div></fieldset>
          <button class="reset" type="button">最初のレシピに戻す ↺</button>
          <p class="motion-note">端末で動きを減らす設定をしている場合は、離した位置で止まります。</p>
        </section>
      </div>
      <section class="under-the-hood" aria-labelledby="code-title">
        <div><p class="eyebrow">小さな仕掛けの、裏側</p><h2 id="code-title">動きをつくるのは、<br />「重さ」と「はずみ」。</h2><p>手を離すと重力で加速し、床に当たると上向きに跳ね返る。少しずつ勢いを失って、最後は止まります。上に持ち上げるほど影が薄く小さくなり、高さも感じられます。</p><p>絵はSVG、操作はPointer Events。指でもマウスでも同じように触れます。物が動いている間だけ、落下と跳ね返りを計算しています。</p></div>
        <div class="code-note"><span>いまの設定 · 実装の抜粋</span><pre><code id="recipe-code"></code></pre><p>この抜粋は落下と反発の考え方です。実装には停止判定、壁との反発、摩擦、ドラッグ処理も含まれます。</p><a href="https://github.com/R-Koda/ryu-koda.com/blob/main/src/components/LabToys.astro" target="_blank" rel="noopener noreferrer">動くコード全体をGitHubで見る ↗</a></div>
      </section>
      <a class="next" href="/blog/css-popout-drawer/">次は、自分で仕掛けをつくってみる？<br /><strong>引き出しから飛び出すアニメーションの作り方 →</strong></a>
      <ShareLinks title="Webの実験室｜CSS・JavaScriptの動くデモと作り方 | りゅうのらぼ" />
    </main><Footer />
  </body>
</html>
<script>
  const lab = document.querySelector<HTMLElement>('[data-toy-lab]')!;
  const slider = document.querySelector<HTMLInputElement>('#bounce')!;
  const output = document.querySelector<HTMLOutputElement>('#bounce-value')!;
  const code = document.querySelector<HTMLElement>('#recipe-code')!;
  const colors = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="toy-color"]'));
  function update() {
    const bounce = Number(slider.value);
    lab.dataset.bounce = slider.value; output.value = slider.value;
    const color = colors.find(c => c.checked)!.value;
    lab.style.setProperty('--toy-accent', color);
    code.textContent = `// 色はCSS変数で変更\n// --toy-accent: ${color};\n\nconst gravity = 1100;\nconst restitution = ${(.2 + bounce * .006).toFixed(2)};\n\n// 下向きに加速する\nvy += gravity * dt;\ny += vy * dt;\n\n// 床で勢いを弱めて跳ね返る\nif (y >= floor) {\n  y = floor;\n  vy = -Math.abs(vy) * restitution;\n}`;
  }
  slider.addEventListener('input', update);
  colors.forEach(c => c.addEventListener('change', update));
  document.querySelector('.reset')!.addEventListener('click', () => {
    slider.value = '65'; colors[0].checked = true; update();
    lab.querySelectorAll('.lab-toys').forEach(scene => scene.dispatchEvent(new Event('toy-reset')));
  });
  update();
</script>
<style>
  .playground { padding-top:42px; padding-bottom:70px; }
  .back { font-size:13px; }
  .eyebrow { margin:36px 0 12px; font-size:11px; letter-spacing:.14em; color:#536a75; }
  h1 { font-size:clamp(30px,5vw,52px); font-weight:700; letter-spacing:.03em; }
  .lead { margin:22px 0 36px; line-height:2; color:var(--muted); }
  .workbench { display:grid; grid-template-columns:minmax(0,1.65fr) minmax(260px,1fr); gap:26px; }
  .stage { border:2px solid #354550; border-radius:12px 18px 13px 9px; box-shadow:6px 7px 0 #e5edf5; padding:26px; background:radial-gradient(#a4b4c34a 1px,transparent 1px) 0 0/18px 18px; }
  .stage-top { display:flex; justify-content:space-between; gap:14px; align-items:center; }
  h2 { font-size:19px; font-weight:700; line-height:1.6; }
  .stage-top span { font-size:10px; color:#526477; white-space:nowrap; }
  .desk { padding:10px 0 30px; }
  .stage-hint { text-align:center; font-size:14px; line-height:1.9; }
  .keyboard-help { text-align:center; font-size:11px; margin-top:18px; color:var(--muted); }
  .controls { padding:28px; background:#fffae8; border:1px solid #d7cba7; border-radius:8px 13px 9px 11px; }
  .controls > label { display:flex; justify-content:space-between; margin-top:30px; font-size:14px; }
  output { font-variant-numeric:tabular-nums; }
  input[type=range] { width:100%; height:36px; accent-color:#365f8c; cursor:pointer; }
  .range-labels { display:flex; justify-content:space-between; font-size:11px; color:var(--muted); }
  fieldset { padding:0; border:0; margin:28px 0; }
  legend { font-size:14px; margin-bottom:12px; }
  .swatches { display:flex; flex-wrap:wrap; gap:10px; }
  .swatches label { cursor:pointer; font-size:12px; padding:8px; border:1px solid #a8b1b5; border-radius:6px; background:var(--swatch); }
  .swatches input { accent-color:#354550; }
  .reset { border:1.5px solid #354550; background:white; border-radius:5px; padding:10px 16px; cursor:pointer; box-shadow:2px 3px 0 #354550; font-size:13px; }
  .reset:hover { background:#e3eee6; }
  .reset:active { transform:translateY(2px); box-shadow:none; }
  .motion-note { font-size:11px; line-height:1.8; color:var(--muted); margin-top:20px; }
  .under-the-hood { display:grid; grid-template-columns:1fr 1.2fr; gap:50px; margin:70px 0 40px; }
  .under-the-hood .eyebrow { margin-top:0; }
  .under-the-hood h2 { font-size:26px; }
  .under-the-hood p:not(.eyebrow) { font-size:14px; margin-top:18px; }
  .code-note { min-width:0; background:#f3f6f8; border:1px solid #d9e1e8; border-radius:8px; padding:24px; }
  .code-note > span { font-size:11px; color:#536a75; }
  pre { overflow-x:auto; font-size:12px; line-height:1.9; }
  .code-note p { font-size:11px!important; }
  .code-note a { font-size:13px; display:inline-block; margin-top:16px; }
  .next { display:block; padding:24px; border-left:4px solid #dfbf61; background:#fffae8; text-decoration:none; font-size:14px; line-height:2; }
  @media(max-width:760px) { .workbench,.under-the-hood { grid-template-columns:minmax(0,1fr); } .stage,.controls { padding:20px; } .desk { padding:0 0 25px; } .stage-top { flex-wrap:wrap; } .under-the-hood { gap:24px; margin-top:44px; } }
</style>

<style>.kit-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;margin:35px 0 60px}.kit{background:var(--kit-color);border:2px solid #354550;border-radius:7px 13px 8px 6px;padding:24px;box-shadow:4px 5px 0 #35455022;display:flex;flex-direction:column;text-decoration:none;transition:transform .2s}.kit:is(:hover,:focus-visible){transform:translateY(-4px) rotate(-.5deg)}.kit:focus-visible{outline:3px solid #2458a6;outline-offset:6px}.kit:active{box-shadow:1px 2px 0 #35455033}.kit>span{font-size:10px;letter-spacing:.08em;color:#52646d}.kit strong{font-size:20px;margin:14px 0}.kit p{font-size:13px;line-height:1.9;flex:1}.kit b{font-size:12px;margin-top:22px}.first-kit{margin-bottom:24px}@media(max-width:850px){.kit-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:520px){.kit-grid{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){.kit{transition:none}.kit:is(:hover,:focus-visible){transform:none}}</style>
