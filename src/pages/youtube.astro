---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ActionLink from "../components/ActionLink.astro";
import ChannelSurprise from "../components/ChannelSurprise.astro";
import channels from "../data/youtube.json";
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead
      title="YouTube・動画 | りゅうのらぼ"
      description="りゅうのらぼの動画制作。AIことばラボ、しくみの裏側、からだの裏側など、テーマごとのYouTubeチャンネルをご紹介します。"
    />
  </head>
  <body>
    <Header />
    <main id="main" class="shell videos">
      <p class="eyebrow">YOUTUBE</p>
      <h1>動画のひきだし</h1>
      <p class="lead">
        文章だけでなく、映像でも。
        <br />
        AIの使い方、身近なしくみ、研究の話を動画にしています。
      </p>
      <section class="channel-grid" aria-label="制作しているYouTubeチャンネル">
        {channels.map((channel, i) => (
          <article class="channel">
            <ChannelSurprise index={i} />
            <div class="channel-meta">
              <span>0{i + 1}</span>
              <span>{channel.topic}</span>
            </div>
            <h2>{channel.name}</h2>
            <p>{channel.description}</p>
            <ActionLink href={channel.url} external variant="outline">
              YouTubeで見る
            </ActionLink>
          </article>
        ))}
      </section>
      <div class="video-note">
        <h2>それぞれのチャンネルで見る</h2>
        <p>
          このページでは、制作しているチャンネルをテーマ別にまとめています。視聴できる動画は各チャンネルでご確認ください。
        </p>
      </div>
    </main>
    <Footer />
  </body>
</html>
<style>
  .videos {
    padding-top: 50px;
  }
  .eyebrow {
    color: var(--muted);
  }
  h1 {
    display: inline-block;
    margin: 18px 0 22px;
    font-size: 32px;
    font-weight: 700;
    background: linear-gradient(transparent 75%, #eee0ff 75%);
    transform: rotate(-1deg);
  }
  .lead {
    font-size: 15px;
    color: var(--muted);
    line-height: 2;
    margin-bottom: 78px;
  }
  .channel-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 78px 25px;
  }
  .channel {
    position: relative;
    transition: transform .2s, box-shadow .2s;
    --color: #e6eefb;
    border: 1.5px solid #303d48;
    border-top: 8px solid var(--color);
    border-radius: 6px 10px 8px 5px;
    padding: 24px;
    box-shadow: 4px 4px 0 #e5e8ee;
    display: flex;
    flex-direction: column;
    align-items: start;
  }
  .channel:is(:hover, :focus-within) {
    transform: translateY(-4px);
    box-shadow: 5px 8px 0 #303d4820;
    z-index: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .channel { transition: none; }
    .channel:is(:hover, :focus-within) { transform: none; }
  }
  .channel:nth-child(3n + 2) {
    --color: #ffe9a4;
  }
  .channel:nth-child(3n) {
    --color: #dcebdc;
  }
  .channel-meta {
    width: 100%;
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--muted);
    gap: 14px;
  }
  .channel-meta > span:last-child {
    background: var(--color);
    padding: 1px 7px;
    border-radius: 3px;
  }
  .channel h2 {
    font-size: 21px;
    font-weight: 700;
    margin: 22px 0 14px;
    line-height: 1.6;
  }
  .channel p {
    font-size: 13px;
    line-height: 1.9;
    color: var(--muted);
    margin-bottom: 25px;
  }
  .channel :global(.action) {
    margin-top: auto;
    width: 100%;
    gap: 8px;
  }
  .video-note {
    margin-top: 48px;
    border-top: 1px dashed #aeb5bc;
    padding-top: 24px;
    max-width: 700px;
  }
  .video-note h2 {
    font-size: 16px;
    font-weight: 700;
  }
  .video-note p {
    font-size: 13px;
    color: var(--muted);
    line-height: 2;
    margin-top: 10px;
  }
  @media (max-width: 1000px) {
    .channel-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .videos {
      padding-top: 32px;
    }
    h1 {
      font-size: 28px;
    }
    .channel-grid {
      grid-template-columns: 1fr;
      gap: 78px;
    }
    .channel {
      padding: 22px;
    }
    .lead {
      font-size: 14px;
    }
  }
</style>
