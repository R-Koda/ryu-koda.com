---
import { navigation } from "../data/navigation";
import DrawerAvatar from "../components/DrawerAvatar.astro";
import LabToys from "../components/LabToys.astro";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ActionLink from "../components/ActionLink.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { journalPosts } from "../lib/posts";
import starters from "../data/starter-articles.json";
import FollowNote from "../components/FollowNote.astro";
const posts = (await journalPosts()).slice(0, 3);
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead
      title="りゅうのらぼ | AI・ソフトウェア・日々の道具"
      description="AIやアプリ、自動化、日々の道具について調べ、つくり、記録する個人ブログ。ソフトウェア開発や研究の取り組み、仕事の紹介もまとめています。"
    />
  </head>
  <body>
    <Header />
    <main id="main" class="shell">
      <section class="intro" aria-labelledby="intro-title">
        <div class="intro-copy">
          <LabToys position="top" />
          <h1 id="intro-title">
            今日も、
            <br />
            <span>なんかやってます。</span>
          </h1>
          <p class="intro-lead">
            気になったことを調べ、つくり、記録しています。
          </p>
          <div class="actions">
            <ActionLink href="/about/" variant="outline">
              プロフィールを見る
            </ActionLink>
            <ActionLink
              href="https://github.com/R-Koda"
              external
              variant="text"
            >
              GitHub
            </ActionLink>
          </div>
          <LabToys position="bottom" />
        </div>
        <aside class="index" aria-label="らぼのひきだし">
          <div class="drawer-caption">
            <span>りゅうのらぼ</span>
            <b>らぼのひきだし</b>
            <small>気になるところから、どうぞ。</small>
          </div>
          <div class="drawer-box">
            {navigation.filter((item) => item.href !== "/" && item.href !== "/contact/").map((item, index) => (
              <a href={item.href} class="drawer" style={`--drawer-color: ${item.color}`}>
                <span class="drawer-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <span class="drawer-label">
                  <b>{item.drawer}</b>
                  <small>{item.description}</small>
                </span>
                <DrawerAvatar kind={item.href.split("/")[1]} />
                <span class="drawer-handle" aria-hidden="true"></span>
              </a>
            ))}
          </div>
        </aside>
      </section>
      <section id="journal" class="content-section">
        <div class="section-heading">
          <h2>最近の記事</h2>
          <ActionLink href="/blog/" variant="text">
            記事一覧
          </ActionLink>
        </div>
        <div class="journal-list">
          {posts.map((p) => (
            <a class="journal-row" href={`/blog/${p.id}/`}>
              <div class="article-date">
                <FormattedDate date={p.data.pubDate} />
                <span>{p.data.tags?.[0] || "ブログ"}</span>
              </div>
              <div class="article-copy">
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
              </div>
              <span class="row-arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))}
        </div>
      </section>
      <section class="start-here" aria-labelledby="start-title">
        <div class="section-heading"><h2 id="start-title">まずは、この3つから。</h2></div>
        <p class="start-lead">つくること、道具を選ぶこと、気になることを掘り下げること。りゅうのらぼの楽しみ方を、3つの記事に。</p>
        <div class="starter-grid">{starters.map(({slug, ...guide}) => (
          <a class="starter-card" href={`/blog/${slug}/`}>
            <img src={guide.image} alt={guide.imageAlt} width="1200" height="630" loading="lazy" decoding="async" />
            <span>{guide.purpose}</span><h3>{guide.label}</h3><p>{guide.evidence}</p><b>読んでみる ↗</b>
          </a>
        ))}</div>
      </section>
      <FollowNote />
      <section class="personal-note">
        <h2>このブログについて</h2>
        <div>
          <p>
            便利なアプリ、小さな自動化、仕事や暮らしに使う道具。調べたことと、実際に試したことを区別しながら、自分の言葉で残していく場所にしたいと思っています。
          </p>
          <ActionLink href="/about/" variant="text">
            書いている人について
          </ActionLink>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
<style>
  .start-here { margin: 38px 0 56px; }
  .start-lead { font-size: 14px; color: var(--muted); line-height: 1.9; margin: 24px 0; }
  .starter-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .starter-card { display: flex; flex-direction: column; padding: 16px; border: 1.5px solid #34434d; border-radius: 9px; text-decoration: none; box-shadow: 4px 4px 0 #e4edf7; transition: transform .2s; }
  .starter-card:nth-child(2) { box-shadow: 4px 4px 0 #fff0b8; }
  .starter-card:nth-child(3) { box-shadow: 4px 4px 0 #e3efdf; }
  .starter-card:hover { transform: translateY(-3px); }
  .starter-card img { width: 100%; height: auto; border-radius: 5px; margin-bottom: 18px; }
  .starter-card span { font-size: 12px; color: #41638a; }
  .starter-card h3 { font-size: 18px; line-height: 1.7; margin: 10px 0; }
  .starter-card p { font-size: 12px; color: var(--muted); line-height: 1.8; margin-bottom: 18px; }
  .starter-card b { margin-top: auto; font-size: 13px; }
  @media(max-width:760px) { .starter-grid { grid-template-columns: 1fr; } }
  @media(prefers-reduced-motion:reduce) { .starter-card { transition: none; } .starter-card:hover { transform: none; } }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 270px;
    gap: 80px;
    padding: 60px 0 50px;
    align-items: end;
  }
  .overline {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 25px;
  }
  .intro h1 {
    font:
      700 clamp(28px, 3.5vw, 42px)/1.5 Atkinson,
      sans-serif;
    letter-spacing: 0.02em;
  }
  .intro h1 span {
    color: var(--accent);
  }
  .intro-lead {
    font-size: 17px;
    line-height: 2;
    margin: 30px 0;
  }
  .index-title {
    font-size: 11px;
    color: var(--muted);
    display: block;
    margin-bottom: 12px;
  }
  .index a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    gap: 15px;
  }
  .index b {
    font-size: 13px;
    font-weight: 400;
  }
  .index small {
    display: block;
    font-size: 10px;
    color: var(--muted);
    margin-top: 4px;
  }
  .index a > span:last-child {
    transition: transform 0.2s;
  }
  .index a:hover > span:last-child {
    transform: translateY(3px);
  }
  .content-section {
    margin-top: 40px;
  }
  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 14px;
  }
  .section-heading h2,
  .personal-note h2 {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .section-caption {
    font-size: 11px;
    color: var(--muted);
  }
  .journal-row {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr) 24px;
    gap: 32px;
    padding: 32px 0;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .article-date {
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    padding-top: 5px;
  }
  .article-date span {
    display: block;
    font-size: 10px;
    margin-top: 8px;
  }
  .article-copy h3 {
    font-size: 21px;
    line-height: 1.7;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    transition: text-decoration-color 0.2s;
  }
  .article-copy p {
    font-size: 13px;
    line-height: 1.9;
    color: var(--muted);
    margin-top: 12px;
    max-width: 680px;
  }
  .row-arrow {
    align-self: center;
    transition: transform 0.2s;
  }
  .journal-row:hover h3 {
    text-decoration-color: currentColor;
  }
  .journal-row:hover .row-arrow {
    transform: translateX(4px);
  }
  #work {
    margin-top: 80px;
  }
  .project {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 65px;
    padding: 40px 0 10px;
  }
  .project-identity {
    border-left: 3px solid #345b49;
    padding-left: 25px;
    align-self: start;
  }
  .project-kicker {
    font-size: 11px;
    color: var(--muted);
  }
  .project-identity h3 {
    font:
      46px/1.05 Georgia,
      serif;
    letter-spacing: -0.04em;
    margin: 22px 0;
  }
  .project-domain {
    font-size: 11px;
    color: var(--muted);
    text-decoration: none;
  }
  .project-detail > p:first-child {
    font-size: 19px;
    line-height: 1.8;
  }
  .project-description {
    font-size: 14px;
    color: var(--muted);
    margin-top: 20px;
    line-height: 2;
  }
  .project-topics {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 11px;
    margin: 24px 0 28px;
    color: var(--muted);
  }
  .personal-note {
    margin-top: 90px;
    padding-top: 30px;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 65px;
  }
  .personal-note p {
    font-size: 14px;
    line-height: 2;
    color: var(--muted);
    margin-bottom: 15px;
  }
  @media (max-width: 760px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 46px 0 30px;
    }
    .intro h1 {
      font-size: 28px;
    }
    .intro-lead {
      font-size: 14px;
      margin: 25px 0;
    }
    .index {
      display: none;
    }
    .journal-row {
      grid-template-columns: minmax(0, 1fr) 18px;
      gap: 12px;
      padding: 24px 0;
    }
    .article-date {
      grid-column: 1/-1;
      display: flex;
      gap: 15px;
      align-items: center;
      padding: 0;
    }
    .article-date span {
      margin: 0;
    }
    .article-copy h3 {
      font-size: 17px;
    }
    .article-copy p {
      font-size: 12px;
    }
    .project,
    .personal-note {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .section-caption {
      display: none;
    }
    #work {
      margin-top: 55px;
    }
    .personal-note {
      margin-top: 55px;
    }
    .project-detail > p:first-child {
      font-size: 17px;
    }
  }

  .intro {
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 70px;
    padding-top: 72px;
    align-items: center;
  }
  .overline {
    display: inline-block;
    background: #e9f1fc;
    border: 1px solid #aec1da;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 11px;
    transform: rotate(-1deg);
  }
  .intro h1 {
    font-size: clamp(30px, 3.4vw, 44px);
    font-weight: 700;
    line-height: 1.7;
    letter-spacing: 0.04em;
  }
  .intro h1 > span {
    background: linear-gradient(
      transparent 75%,
      #ffe698 75%,
      #ffe698 95%,
      transparent 95%
    );
  }
  .intro-lead {
    font-size: 15px;
    margin: 24px 0 28px;
  }
  .index {
    padding: 22px 22px 16px;
    border: 1.5px solid #303d48;
    border-radius: 10px 12px 8px 9px;
    box-shadow: 5px 6px 0 #e5e8ed;
    transform: rotate(2deg);
    position: relative;
    background: #fff;
  }
  .index::before {
    content: "";
    position: absolute;
    top: -9px;
    left: 100px;
    width: 75px;
    height: 18px;
    background: #ffe493d9;
    border: 1px solid #dfbf69;
    transform: rotate(-6deg);
  }
  .index-title {
    font-size: 12px;
    margin-bottom: 14px;
    color: #394c5d;
  }
  .index a {
    border-top: 1px dashed #b8c0c8;
    padding: 16px 0;
  }
  .index a b {
    display: inline-block;
    padding: 0 6px;
    background: #e9f1fc;
  }
  .index a:nth-of-type(2) b {
    background: #e4f0e3;
  }
  .index a:nth-of-type(3) b {
    background: #fce4dc;
  }
  .section-heading {
    border-bottom: 1px dashed #adb4bb;
    padding-bottom: 20px;
  }
  .section-heading h2 {
    background: #fff0b8;
    border: 1.5px solid #303d48;
    padding: 8px 18px;
    font-size: 18px;
    border-radius: 5px;
    box-shadow: 2px 3px 0 #303d48;
    transform: rotate(-1deg);
  }
  #work .section-heading h2 {
    background: #e2efe4;
    transform: rotate(1deg);
  }
  .journal-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px;
    margin-top: 28px;
  }
  .journal-row {
    grid-template-columns: minmax(0, 1fr) 22px;
    gap: 16px;
    border: 1.5px solid #303d48;
    border-radius: 8px 10px 7px 9px;
    padding: 24px;
    box-shadow: 4px 4px 0 #e3ebf6;
    position: relative;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .journal-row:nth-child(2n) {
    box-shadow: 4px 4px 0 #f4e6d6;
  }
  .journal-row:hover {
    transform: translateY(-3px);
    box-shadow: 5px 7px 0 #d4e2f4;
  }
  .article-date {
    grid-column: 1/-1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0;
  }
  .article-date span {
    margin: 0;
    border-radius: 3px;
    background: #edf3fb;
    padding: 2px 8px;
  }
  .article-copy h3 {
    font-size: 18px;
  }
  .article-copy p {
    font-size: 12px;
  }
  .row-arrow {
    align-self: end;
  }
  .project {
    background: #f5f9f4;
    border: 1.5px solid #87998a;
    border-radius: 9px;
    padding: 35px;
    margin-top: 28px;
    gap: 45px;
  }
  .project-identity {
    border-left: 0;
    padding-left: 0;
  }
  .project-kicker {
    background: white;
    border: 1px solid #b2c3b5;
    padding: 4px 8px;
    border-radius: 3px;
  }
  .project-identity h3 {
    font-size: 42px;
  }
  .personal-note {
    border-top: 1px dashed #adb4bb;
  }
  .personal-note h2 {
    font-size: 17px;
  }
  @media (max-width: 760px) {
    .intro {
      grid-template-columns: 1fr;
      padding-top: 38px;
      gap: 34px;
    }
    .intro h1 {
      font-size: 30px;
    }
    .index {
      display: block;
      transform: rotate(0);
      padding: 20px;
      max-width: 100%;
      box-shadow: 3px 4px 0 #e5e8ed;
    }
    .index a {
      padding: 12px 0;
    }
    .journal-list {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .journal-row {
      padding: 20px;
      gap: 14px;
    }
    .section-heading h2 {
      font-size: 16px;
      padding: 7px 12px;
    }
    .section-heading {
      gap: 14px;
    }
    .article-copy h3 {
      font-size: 17px;
    }
    .project {
      padding: 25px 20px;
      gap: 28px;
    }
    .project-identity h3 {
      font-size: 37px;
    }
  }

  /* A small cabinet is the site's recurring wayfinding motif. */
  .intro {
    grid-template-columns: minmax(0, 1fr) 335px;
  }
  .index {
    border: 0;
    padding: 0;
    background: transparent;
    box-shadow: none;
    transform: none;
    overflow: visible;
  }
  .index::before {
    display: none;
  }
  .drawer-caption {
    text-align: center;
    margin-bottom: 22px;
    transform: rotate(-2deg);
  }
  .drawer-caption > span {
    font-family: "Yomogi Logo", sans-serif;
    font-size: 19px;
    display: block;
    line-height: 1.5;
  }
  .drawer-caption > b {
    display: block;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin: 5px 0;
  }
  .drawer-caption > small {
    font-size: 11px;
    color: var(--muted);
  }
  .drawer-box {
    border: 2px solid #303d48;
    border-radius: 9px 9px 4px 4px;
    background: #e7e1d6;
    padding: 10px 10px 15px;
    box-shadow: 7px 8px 0 #e8ebef;
    position: relative;
    isolation: isolate;
  }
  .drawer-box::before,
  .drawer-box::after {
    content: "";
    position: absolute;
    bottom: -10px;
    width: 25px;
    height: 10px;
    background: #303d48;
    border-radius: 0 0 3px 3px;
  }
  .drawer-box::before {
    left: 20px;
  }
  .drawer-box::after {
    right: 20px;
  }
  .drawer-box .drawer {
    position: relative;
    display: grid;
    grid-template-columns: 23px minmax(0, 1fr) 29px;
    align-items: center;
    gap: 10px;
    border: 1.5px solid #303d48;
    border-radius: 4px;
    background: var(--drawer-color, #fff0b8);
    padding: 12px 14px;
    margin: 0 0 9px;
    box-shadow: 0 4px 0 #303d48;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
    min-height: 80px;
    transform-origin: center;
  }
  .drawer-box .drawer:last-child {
    margin-bottom: 0;
  }
  .drawer-number {
    align-self: start;
    font:
      11px/2 Atkinson,
      sans-serif;
    color: #58616a;
  }
  .drawer-label > b {
    background: white !important;
    border: 1px solid #303d4830;
    border-radius: 2px;
    padding: 1px 8px !important;
    font-size: 13px !important;
  }
  .drawer-label > small {
    font-size: 10px;
    color: #4a555d !important;
    margin-top: 7px;
    line-height: 1.6;
  }
  .drawer-handle {
    width: 27px;
    height: 9px;
    border: 1.5px solid #303d48;
    border-radius: 3px;
    background: #ffffffa6;
    box-shadow: 0 2px 0 #303d4840;
    transform: none !important;
  }
  .drawer-box .drawer:hover,
  .drawer-box .drawer:focus-visible {
    z-index: 3;
    transform: translate(-9px, 3px);
    box-shadow: 9px 9px 0 #303d48;
    color: var(--ink);
  }
  .drawer-box .drawer:active {
    transform: translate(0, 2px);
    box-shadow: 0 2px 0 #303d48;
  }
  .journal-row {
    border-radius: 4px 11px 7px 5px;
    border-top: 7px solid #f2d46c;
  }
  .journal-row:nth-child(2n) {
    border-top-color: #aecbe9;
  }
  .article-date span {
    background: #fff4cc;
  }
  .journal-row:nth-child(2n) .article-date span {
    background: #e9f1fc;
  }
  .project {
    border-top: 7px solid #a9c5ad;
  }
  .personal-note h2 {
    display: inline-block;
    align-self: start;
    justify-self: start;
    background: #fce3db;
    padding: 5px 10px;
    border-radius: 3px;
    transform: rotate(-1deg);
  }
  @media (max-width: 760px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 42px;
    }
    .index {
      width: min(335px, 100%);
      margin: 0 auto;
      padding: 0;
      box-shadow: none;
    }
    .drawer-caption {
      margin-bottom: 15px;
    }
    .drawer-caption > b {
      font-size: 18px;
    }
    .drawer-box .drawer {
      min-height: 83px;
      padding: 14px 10px;
      gap: 8px;
    }
    .drawer-label > small {
      font-size: 9px;
    }
    .drawer-box {
      box-shadow: 4px 5px 0 #e8ebef;
    }
    .drawer-box .drawer:hover,
    .drawer-box .drawer:focus-visible {
      transform: translate(-2px, -2px);
      box-shadow: 2px 5px 0 #303d48;
    }
  }
  @font-face {
    font-family: "Yomogi Greeting";
    src: url("/fonts/yomogi-greeting.ttf") format("truetype");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }
  .intro h1 {
    font-family: "Yomogi Greeting", sans-serif;
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.8;
    font-size: clamp(28px, 3.2vw, 40px);
  }
  @media (max-width: 760px) {
    .intro h1 {
      font-size: 28px;
      letter-spacing: 0.04em;
    }
  }
  .intro {
    padding-top: 38px;
    align-items: center;
    gap: 50px;
  }
  .intro-copy {
    min-width: 0;
  }
  .intro-lead {
    margin: 20px 0 24px;
