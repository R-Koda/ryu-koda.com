---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ActionLink from "../components/ActionLink.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { journalPosts } from "../lib/posts";
const posts = (await journalPosts()).slice(0, 3);
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead
      title="りゅうのラボ | 技術と研究の記録"
      description="Ryu Kodaの個人サイト。ソフトウェア開発、医学の公開データ研究、アプリや道具についての記録。"
    />
  </head>
  <body>
    <Header />
    <main id="main" class="shell">
      <section class="intro" aria-labelledby="intro-title">
        <div class="intro-copy">
          <p class="overline">ソフトウェア・医学データ・日々の道具</p>
          <h1 id="intro-title">技術と研究の記録</h1>
          <p class="intro-lead">
            ソフトウェアと、医学のデータ。
            <br />
            気になったことを調べ、つくり、記録しています。
          </p>
          <div class="actions">
            <ActionLink href="/about/" variant="outline">
              プロフィールを見る
            </ActionLink>
            <ActionLink
              href="https://github.com/R-Koda"
              external
              variant="text"
            >
              GitHub
            </ActionLink>
          </div>
        </div>
        <aside class="index" aria-label="このサイトの案内">
          <span class="index-title">このサイトで読めること</span>
          <a href="#journal">
            <span>
              <b>ブログ</b>
              <small>AI・アプリ・自動化・道具</small>
            </span>
            <span aria-hidden="true">↓</span>
          </a>
          <a href="#work">
            <span>
              <b>プロジェクト</b>
              <small>医学の公開データを使った研究</small>
            </span>
            <span aria-hidden="true">↓</span>
          </a>
          <a href="/about/">
            <span>
              <b>プロフィール</b>
              <small>関心のあること、活動について</small>
            </span>
            <span aria-hidden="true">→</span>
          </a>
        </aside>
      </section>
      <section id="journal" class="content-section">
        <div class="section-heading">
          <h2>最近の記事</h2>
          <ActionLink href="/blog/" variant="text">
            記事一覧
          </ActionLink>
        </div>
        <div class="journal-list">
          {posts.map((p) => (
            <a class="journal-row" href={`/blog/${p.id}/`}>
              <div class="article-date">
                <FormattedDate date={p.data.pubDate} />
                <span>{p.data.tags?.[0] || "ブログ"}</span>
              </div>
              <div class="article-copy">
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
              </div>
              <span class="row-arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))}
        </div>
      </section>
      <section id="work" class="content-section">
        <div class="section-heading">
          <h2>プロジェクト</h2>
          <span class="section-caption">個人で取り組んでいること</span>
        </div>
        <div class="project">
          <div class="project-identity">
            <span class="project-kicker">医学 × オープンデータ</span>
            <h3>
              Solo
              <br />
              <em>Researcher</em>
            </h3>
            <a
              class="project-domain"
              href="https://solo-researcher.com/"
              target="_blank"
              rel="noopener noreferrer"
            >
              solo-researcher.com ↗
              <span class="sr-only">（新しいタブで開く）</span>
            </a>
          </div>
          <div class="project-detail">
            <p>
              公開データから研究の問いを探す、
              <br />
              もうひとつの個人サイトです。
            </p>
            <p class="project-description">
              医学のデータ解析、読んだ論文、研究の過程を記録しています。てんかんや認知症などのNeuroscienceを中心に、データを使った研究に関心があります。
            </p>
            <ul class="project-topics">
              <li>解説記事</li>
              <li>論文紹介</li>
              <li>データ紹介</li>
              <li>研究日誌</li>
            </ul>
            <ActionLink
              href="https://solo-researcher.com/"
              external
              variant="outline"
            >
              サイトを読む
            </ActionLink>
          </div>
        </div>
      </section>
      <section class="personal-note">
        <h2>このブログについて</h2>
        <div>
          <p>
            便利なアプリ、小さな自動化、仕事や暮らしに使う道具。調べたことと、実際に試したことを区別しながら、自分の言葉で残していく場所にしたいと思っています。
          </p>
          <ActionLink href="/about/" variant="text">
            書いている人について
          </ActionLink>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 270px;
    gap: 80px;
    padding: 60px 0 50px;
    align-items: end;
  }
  .overline {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 25px;
  }
  .intro h1 {
    font:
      700 clamp(28px, 3.5vw, 42px)/1.5 Atkinson,
      sans-serif;
    letter-spacing: 0.02em;
  }
  .intro h1 span {
    color: var(--accent);
  }
  .intro-lead {
    font-size: 17px;
    line-height: 2;
    margin: 30px 0;
  }
  .index-title {
    font-size: 11px;
    color: var(--muted);
    display: block;
    margin-bottom: 12px;
  }
  .index a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    gap: 15px;
  }
  .index b {
    font-size: 13px;
    font-weight: 400;
  }
  .index small {
    display: block;
    font-size: 10px;
    color: var(--muted);
    margin-top: 4px;
  }
  .index a > span:last-child {
    transition: transform 0.2s;
  }
  .index a:hover > span:last-child {
    transform: translateY(3px);
  }
  .content-section {
    margin-top: 40px;
  }
  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 14px;
  }
  .section-heading h2,
  .personal-note h2 {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .section-caption {
    font-size: 11px;
    color: var(--muted);
  }
  .journal-row {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr) 24px;
    gap: 32px;
    padding: 32px 0;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .article-date {
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    padding-top: 5px;
  }
  .article-date span {
    display: block;
    font-size: 10px;
    margin-top: 8px;
  }
  .article-copy h3 {
    font-size: 21px;
    line-height: 1.7;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    transition: text-decoration-color 0.2s;
  }
  .article-copy p {
    font-size: 13px;
    line-height: 1.9;
    color: var(--muted);
    margin-top: 12px;
    max-width: 680px;
  }
  .row-arrow {
    align-self: center;
    transition: transform 0.2s;
  }
  .journal-row:hover h3 {
    text-decoration-color: currentColor;
  }
  .journal-row:hover .row-arrow {
    transform: translateX(4px);
  }
  #work {
    margin-top: 80px;
  }
  .project {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 65px;
    padding: 40px 0 10px;
  }
  .project-identity {
    border-left: 3px solid #345b49;
    padding-left: 25px;
    align-self: start;
  }
  .project-kicker {
    font-size: 11px;
    color: var(--muted);
  }
  .project-identity h3 {
    font:
      46px/1.05 Georgia,
      serif;
    letter-spacing: -0.04em;
    margin: 22px 0;
  }
  .project-domain {
    font-size: 11px;
    color: var(--muted);
    text-decoration: none;
  }
  .project-detail > p:first-child {
    font-size: 19px;
    line-height: 1.8;
  }
  .project-description {
    font-size: 14px;
    color: var(--muted);
    margin-top: 20px;
    line-height: 2;
  }
  .project-topics {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 11px;
    margin: 24px 0 28px;
    color: var(--muted);
  }
  .personal-note {
    margin-top: 90px;
    padding-top: 30px;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 65px;
  }
  .personal-note p {
    font-size: 14px;
    line-height: 2;
    color: var(--muted);
    margin-bottom: 15px;
  }
  @media (max-width: 760px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 46px 0 30px;
    }
    .intro h1 {
      font-size: 28px;
    }
    .intro-lead {
      font-size: 14px;
      margin: 25px 0;
    }
    .index {
      display: none;
    }
    .journal-row {
      grid-template-columns: minmax(0, 1fr) 18px;
      gap: 12px;
      padding: 24px 0;
    }
    .article-date {
      grid-column: 1/-1;
      display: flex;
      gap: 15px;
      align-items: center;
      padding: 0;
    }
    .article-date span {
      margin: 0;
    }
    .article-copy h3 {
      font-size: 17px;
    }
    .article-copy p {
      font-size: 12px;
    }
    .project,
    .personal-note {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .section-caption {
      display: none;
    }
    #work {
      margin-top: 55px;
    }
    .personal-note {
      margin-top: 55px;
    }
    .project-detail > p:first-child {
      font-size: 17px;
    }
  }
</style>
