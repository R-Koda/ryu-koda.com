---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ActionLink from "../components/ActionLink.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { journalPosts } from "../lib/posts";
const posts = (await journalPosts()).slice(0, 3);
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead
      title="Ryu Koda — Technology, Research & Everyday Life"
      description="Ryu Kodaの個人ポートフォリオ。ソフトウェア、医学の公開データ研究、日々を少し便利にする道具とアイデア。"
    />
  </head>
  <body>
    <Header />
    <main id="main" class="shell">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-meta">
          <span class="eyebrow">Independent mind. Curious by nature.</span>
          <span class="folio">PORTFOLIO / 01</span>
        </div>
        <h1 id="hero-title">
          Ryu <em>Koda</em>
          <span class="name-dot">.</span>
        </h1>
        <div class="hero-bottom">
          <div class="intro">
            <p class="hero-jp">
              知りたい、を深める。
              <br />
              つくって、確かめる。
            </p>
            <p class="hero-description">
              コードを書いたり、医学のデータを眺めたり。
              <br class="desktop" />
              身近な疑問から始まる、研究とものづくりの記録です。
            </p>
            <div class="actions">
              <ActionLink href="#work">取り組みを見る</ActionLink>
              <ActionLink href="/about/" variant="text">
                プロフィール
              </ActionLink>
            </div>
          </div>
          <div class="orbital" aria-hidden="true">
            <svg viewBox="0 0 360 240">
              <g fill="none" stroke="currentColor" stroke-width=".7">
                {Array.from({ length: 16 }, (_, i) => (
                  <ellipse
                    cx="180"
                    cy="116"
                    rx="140"
                    ry={25 + i * 5}
                    transform={`rotate(${i * 5 - 38} 180 116)`}
                  />
                ))}
                <path d="M180 4v224M20 116h320" stroke-dasharray="2 7" />
              </g>
              <circle cx="274" cy="60" r="10" fill="var(--accent)" />
            </svg>
            <span>Ideas take shape through practice.</span>
          </div>
        </div>
        <div class="hero-foot">
          <span>SOFTWARE / RESEARCH / JOURNAL</span>
          <a href="#work">
            SCROLL TO EXPLORE <span>↓</span>
          </a>
        </div>
      </section>
      <section id="work" class="work-section">
        <div class="section-head">
          <div>
            <small>01 — SELECTED WORK</small>
            <h2>取り組んでいること。</h2>
          </div>
          <span class="section-note">考えることと、手を動かすこと。</span>
        </div>
        <a
          class="research-project"
          href="https://solo-researcher.com/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="project-visual" aria-hidden="true">
            <span class="project-number">RESEARCH NOTES / 001</span>
            <div class="paper">
              <span>
                solo
                <br />
                <i>researcher</i>
                <b>+</b>
              </span>
              <small>
                ひとり、こつこつ。
                <br />
                医学の研究ノート。
              </small>
            </div>
            <span class="visual-caption">OPEN DATA, OPEN QUESTIONS.</span>
          </div>
          <div class="project-copy">
            <span class="eyebrow">MEDICINE × OPEN DATA</span>
            <h3>
              Solo Researcher<span aria-hidden="true">↗</span>
            </h3>
            <p>
              医学の公開データから、問いを見つける。
              <br />
              解析の過程や論文、データの読み方を届ける、個人の研究プロジェクト。
            </p>
            <span class="project-link">
              研究ノートを読む <span aria-hidden="true">↗</span>
            </span>
            <span class="sr-only">（新しいタブで開く）</span>
          </div>
        </a>
        <div class="code-line">
          <span class="eyebrow">ALSO ON GITHUB</span>
          <p>小さな自動化から、Webのものづくりまで。</p>
          <ActionLink href="https://github.com/R-Koda" external variant="text">
            コードと活動を見る
          </ActionLink>
        </div>
      </section>
      <section id="journal" class="journal-section">
        <div class="section-head">
          <div>
            <small>02 — JOURNAL</small>
            <h2>試したこと、考えたこと。</h2>
          </div>
          <ActionLink href="/blog/" variant="text">
            すべての記事
          </ActionLink>
        </div>
        <div class="journal-list">
          {posts.map((p, i) => (
            <a href={`/blog/${p.id}/`} class="journal-row">
              <span class="journal-index">0{i + 1}</span>
              <div>
                <span class="post-label">
                  {p.data.tags?.[0] || "TECHNOLOGY"}
                </span>
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
              </div>
              <span class="journal-date">
                <FormattedDate date={p.data.pubDate} />
              </span>
              <span class="row-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          ))}
        </div>
      </section>
      <section class="about-note" id="about">
        <span class="eyebrow">03 — A PERSONAL NOTE</span>
        <div>
          <h2>
            好奇心に、
            <br />
            <em>寄り道を。</em>
          </h2>
          <p>
            技術も、研究も、暮らしの道具も。
            <br />
            分野を行き来しながら、面白いと思ったことを
            <br class="desktop" />
            自分の手で確かめていきたい。
          </p>
          <ActionLink href="/about/" variant="outline">
            Ryu Kodaについて
          </ActionLink>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
<style>
  .hero {
    padding: 38px 0 0;
  }
  .hero-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }
  .folio {
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .hero h1 {
    font: clamp(100px, 16vw, 220px)/1.08 var(--serif);
    letter-spacing: -0.065em;
    margin: 25px 0 35px;
  }
  .hero h1 em {
    font-weight: 400;
  }
  .name-dot {
    color: var(--accent);
  }
  .hero-bottom {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 60px;
    align-items: center;
  }
  .hero-jp {
    font: clamp(25px, 3vw, 38px)/1.65 var(--serif);
    letter-spacing: 0.05em;
  }
  .hero-description {
    font-size: 14px;
    color: var(--muted);
    margin: 22px 0 30px;
    line-height: 2;
  }
  .orbital {
    color: #777f6d;
    text-align: center;
  }
  .orbital svg {
    width: 100%;
    height: auto;
  }
  .orbital > span {
    font: italic 13px var(--serif);
  }
  .hero-foot {
    margin-top: 65px;
    border-top: 1px solid var(--line);
    padding: 18px 0;
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    letter-spacing: 0.12em;
  }
  .hero-foot a {
    text-decoration: none;
  }
  .hero-foot a span {
    margin-left: 20px;
  }
  .work-section {
    margin-top: 110px;
  }
  .section-note {
    font-size: 12px;
    color: var(--muted);
  }
  .research-project {
    display: grid;
    grid-template-columns: 1fr 1fr;
    text-decoration: none;
    color: var(--ink);
    gap: 60px;
    align-items: center;
  }
  .project-visual {
    height: 400px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e1e4d6;
    overflow: hidden;
  }
  .project-number,
  .visual-caption {
    position: absolute;
    font-size: 9px;
    letter-spacing: 0.16em;
    left: 25px;
  }
  .project-number {
    top: 20px;
  }
  .visual-caption {
    bottom: 18px;
  }
  .paper {
    background: #f9f7ef;
    width: 220px;
    height: 290px;
    box-shadow: 8px 12px 0 #c3c9b6;
    padding: 30px;
    transform: rotate(-7deg);
    transition: transform 0.5s;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .paper > span {
    font: 32px/1.1 var(--serif);
    letter-spacing: -0.06em;
  }
  .paper b {
    color: var(--accent);
    display: block;
    font-size: 62px;
    font-weight: 400;
    margin-top: 20px;
  }
  .paper small {
    font-size: 10px;
    line-height: 1.8;
  }
  .research-project:hover .paper {
    transform: rotate(-3deg) translateY(-5px);
  }
  .project-copy h3 {
    font: clamp(30px, 4vw, 48px)/1.3 var(--serif);
    margin: 25px 0;
  }
  .project-copy h3 > span {
    font-family: Atkinson;
    font-size: 25px;
    margin-left: 20px;
  }
  .project-copy p {
    font-size: 14px;
    line-height: 2.1;
    color: var(--muted);
  }
  .project-link {
    margin-top: 35px;
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    padding: 12px 0;
    font-size: 13px;
  }
  .research-project:hover .project-link {
    border-color: var(--accent);
  }
  .code-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    border-bottom: 1px solid var(--line);
    padding: 30px 0;
  }
  .code-line p {
    font-size: 13px;
  }
  .journal-section {
    margin-top: 120px;
  }
  .journal-row {
    display: grid;
    grid-template-columns: 40px 1fr 100px 20px;
    gap: 24px;
    text-decoration: none;
    padding: 32px 8px;
    border-bottom: 1px solid var(--line);
    transition:
      background 0.2s,
      padding 0.2s;
  }
  .journal-row:hover {
    background: #ecece2;
    padding-left: 16px;
  }
  .journal-index {
    font: italic 22px var(--serif);
    color: var(--accent);
  }
  .post-label {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .journal-row h3 {
    font-size: 21px;
    line-height: 1.7;
    margin: 8px 0;
  }
  .journal-row p {
    font-size: 12px;
    color: var(--muted);
    max-width: 620px;
  }
  .journal-date {
    font-size: 10px;
    color: var(--muted);
    align-self: center;
  }
  .row-arrow {
    align-self: center;
    transition: transform 0.2s;
  }
  .journal-row:hover .row-arrow {
    transform: translate(3px, -3px);
  }
  .about-note {
    display: grid;
    grid-template-columns: 1fr 2fr;
    margin-top: 110px;
    border-top: 1px solid var(--ink);
    padding-top: 30px;
    gap: 30px;
  }
  .about-note h2 {
    font: clamp(36px, 5vw, 60px)/1.5 var(--serif);
  }
  .about-note em {
    color: var(--accent);
    font-style: normal;
  }
  .about-note p {
    margin: 25px 0 30px;
    font-size: 14px;
    line-height: 2.1;
  }
  @media (max-width: 760px) {
    .hero-meta .eyebrow {
      font-size: 9px;
    }
    .folio {
      display: none;
    }
    .hero h1 {
      font-size: clamp(80px, 19vw, 145px);
      margin: 30px 0;
    }
    .hero-bottom {
      grid-template-columns: 1fr;
      gap: 25px;
    }
    .orbital {
      width: 230px;
      justify-self: end;
      margin-top: -15px;
    }
    .hero-foot {
      margin-top: 30px;
      font-size: 8px;
    }
    .hero-foot a span {
      margin-left: 5px;
    }
    .work-section,
    .journal-section {
      margin-top: 65px;
    }
    .research-project {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .project-visual {
      height: 340px;
    }
    .project-copy h3 {
      margin: 14px 0;
    }
    .code-line {
      flex-wrap: wrap;
      gap: 10px;
    }
    .code-line p {
      width: 100%;
    }
    .journal-row {
      grid-template-columns: 25px 1fr 15px;
      gap: 12px;
      padding: 25px 0;
    }
    .journal-date {
      grid-column: 2;
      grid-row: 2;
    }
    .journal-row h3 {
      font-size: 17px;
    }
    .journal-row p {
      display: none;
    }
    .about-note {
      grid-template-columns: 1fr;
      margin-top: 70px;
    }
    .desktop {
      display: none;
    }
  }
</style>
