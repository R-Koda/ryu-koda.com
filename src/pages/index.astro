---
import DrawerAvatar from "../components/DrawerAvatar.astro";
import LabToys from "../components/LabToys.astro";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ActionLink from "../components/ActionLink.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { journalPosts } from "../lib/posts";
const posts = (await journalPosts()).slice(0, 3);
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead
      title="りゅうのらぼ | 技術と研究の記録"
      description="Ryu Kodaの個人サイト。ソフトウェア開発、医学の公開データ研究、アプリや道具についての記録。"
    />
  </head>
  <body>
    <Header />
    <main id="main" class="shell">
      <section class="intro" aria-labelledby="intro-title">
        <div class="intro-copy">
          <LabToys position="top" />
          <h1 id="intro-title">
            今日も、
            <br />
            <span>なんかやってます。</span>
          </h1>
          <p class="intro-lead">
            気になったことを調べ、つくり、記録しています。
          </p>
          <div class="actions">
            <ActionLink href="/about/" variant="outline">
              プロフィールを見る
            </ActionLink>
            <ActionLink
              href="https://github.com/R-Koda"
              external
              variant="text"
            >
              GitHub
            </ActionLink>
          </div>
          <LabToys position="bottom" />
        </div>
        <aside class="index" aria-label="らぼのひきだし">
          <div class="drawer-caption">
            <span>りゅうのらぼ</span>
            <b>らぼのひきだし</b>
            <small>気になるところから、どうぞ。</small>
          </div>
          <div class="drawer-box">
            <a href="/blog/" class="drawer drawer-journal">
              <span class="drawer-number" aria-hidden="true">01</span>
              <span class="drawer-label">
                <b><span lang="en">Journal</span><span class="drawer-ja">ブログ</span></b>
                <small>AI・アプリ・自動化・道具</small>
              </span>
              <DrawerAvatar />
              <span class="drawer-handle" aria-hidden="true"></span>
            </a>
            <a href="/youtube/" class="drawer drawer-video">
              <span class="drawer-number" aria-hidden="true">02</span>
              <span class="drawer-label">
                <b><span lang="en">YouTube</span><span class="drawer-ja">動画</span></b>
                <small>AI・しくみ・研究を動画で</small>
              </span>
              <DrawerAvatar />
              <span class="drawer-handle" aria-hidden="true"></span>
            </a>
            <a href="#work" class="drawer drawer-research">
              <span class="drawer-number" aria-hidden="true">03</span>
              <span class="drawer-label">
                <b><span lang="en">Research</span><span class="drawer-ja">研究</span></b>
                <small>医学の公開データを使った研究</small>
              </span>
              <DrawerAvatar />
              <span class="drawer-handle" aria-hidden="true"></span>
            </a>
            <a href="/work/" class="drawer drawer-work">
              <span class="drawer-number" aria-hidden="true">04</span>
              <span class="drawer-label">
                <b><span lang="en">Work</span><span class="drawer-ja">おしごと</span></b>
                <small>つくっているもの・取り組み</small>
              </span>
              <DrawerAvatar />
              <span class="drawer-handle" aria-hidden="true"></span>
            </a>
            <a href="/diary/" class="drawer drawer-diary">
              <span class="drawer-number" aria-hidden="true">05</span>
              <span class="drawer-label">
                <b><span lang="en">Diary</span><span class="drawer-ja">日記</span></b>
                <small>日々のこと、気づいたこと</small>
              </span>
              <DrawerAvatar />
              <span class="drawer-handle" aria-hidden="true"></span>
            </a>
          </div>
        </aside>
      </section>
      <section id="journal" class="content-section">
        <div class="section-heading">
          <h2>最近の記事</h2>
          <ActionLink href="/blog/" variant="text">
            記事一覧
          </ActionLink>
        </div>
        <div class="journal-list">
          {posts.map((p) => (
            <a class="journal-row" href={`/blog/${p.id}/`}>
              <div class="article-date">
                <FormattedDate date={p.data.pubDate} />
                <span>{p.data.tags?.[0] || "ブログ"}</span>
              </div>
              <div class="article-copy">
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
              </div>
              <span class="row-arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))}
        </div>
      </section>
      <section id="work" class="content-section">
        <div class="section-heading">
          <h2>プロジェクト</h2>
          <span class="section-caption">個人で取り組んでいること</span>
        </div>
        <div class="project">
          <div class="project-identity">
            <span class="project-kicker">医学 × オープンデータ</span>
            <h3>
              Solo
              <br />
              <em>Researcher</em>
            </h3>
            <a
              class="project-domain"
              href="https://solo-researcher.com/"
              target="_blank"
              rel="noopener noreferrer"
            >
              solo-researcher.com ↗
              <span class="sr-only">（新しいタブで開く）</span>
            </a>
          </div>
          <div class="project-detail">
            <p>
              公開データから研究の問いを探す、
              <br />
              もうひとつの個人サイトです。
            </p>
            <p class="project-description">
              医学のデータ解析、読んだ論文、研究の過程を記録しています。てんかんや認知症などのNeuroscienceを中心に、データを使った研究に関心があります。
            </p>
            <ul class="project-topics">
              <li>解説記事</li>
              <li>論文紹介</li>
              <li>データ紹介</li>
              <li>研究日誌</li>
            </ul>
            <ActionLink
              href="https://solo-researcher.com/"
              external
              variant="outline"
            >
              サイトを読む
            </ActionLink>
          </div>
        </div>
      </section>
      <section class="personal-note">
        <h2>このブログについて</h2>
        <div>
          <p>
            便利なアプリ、小さな自動化、仕事や暮らしに使う道具。調べたことと、実際に試したことを区別しながら、自分の言葉で残していく場所にしたいと思っています。
          </p>
          <ActionLink href="/about/" variant="text">
            書いている人について
          </ActionLink>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 270px;
    gap: 80px;
    padding: 60px 0 50px;
    align-items: end;
  }
  .overline {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 25px;
  }
  .intro h1 {
    font:
      700 clamp(28px, 3.5vw, 42px)/1.5 Atkinson,
      sans-serif;
    letter-spacing: 0.02em;
  }
  .intro h1 span {
    color: var(--accent);
  }
  .intro-lead {
    font-size: 17px;
    line-height: 2;
    margin: 30px 0;
  }
  .index-title {
    font-size: 11px;
    color: var(--muted);
    display: block;
    margin-bottom: 12px;
  }
  .index a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    gap: 15px;
  }
  .index b {
    font-size: 13px;
    font-weight: 400;
  }
  .index small {
    display: block;
    font-size: 10px;
    color: var(--muted);
    margin-top: 4px;
  }
  .index a > span:last-child {
    transition: transform 0.2s;
  }
  .index a:hover > span:last-child {
    transform: translateY(3px);
  }
  .content-section {
    margin-top: 40px;
  }
  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 14px;
  }
  .section-heading h2,
  .personal-note h2 {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  .section-caption {
    font-size: 11px;
    color: var(--muted);
  }
  .journal-row {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr) 24px;
    gap: 32px;
    padding: 32px 0;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .article-date {
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    padding-top: 5px;
  }
  .article-date span {
    display: block;
    font-size: 10px;
    margin-top: 8px;
  }
  .article-copy h3 {
    font-size: 21px;
    line-height: 1.7;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    transition: text-decoration-color 0.2s;
  }
  .article-copy p {
    font-size: 13px;
    line-height: 1.9;
    color: var(--muted);
    margin-top: 12px;
    max-width: 680px;
  }
  .row-arrow {
    align-self: center;
    transition: transform 0.2s;
  }
  .journal-row:hover h3 {
    text-decoration-color: currentColor;
  }
  .journal-row:hover .row-arrow {
    transform: translateX(4px);
  }
  #work {
    margin-top: 80px;
  }
  .project {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 65px;
    padding: 40px 0 10px;
  }
  .project-identity {
    border-left: 3px solid #345b49;
    padding-left: 25px;
    align-self: start;
  }
  .project-kicker {
    font-size: 11px;
    color: var(--muted);
  }
  .project-identity h3 {
    font:
      46px/1.05 Georgia,
      serif;
    letter-spacing: -0.04em;
    margin: 22px 0;
  }
  .project-domain {
    font-size: 11px;
    color: var(--muted);
    text-decoration: none;
  }
  .project-detail > p:first-child {
    font-size: 19px;
    line-height: 1.8;
  }
  .project-description {
    font-size: 14px;
    color: var(--muted);
    margin-top: 20px;
    line-height: 2;
  }
  .project-topics {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 11px;
    margin: 24px 0 28px;
    color: var(--muted);
  }
  .personal-note {
    margin-top: 90px;
    padding-top: 30px;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 65px;
  }
  .personal-note p {
    font-size: 14px;
    line-height: 2;
    color: var(--muted);
    margin-bottom: 15px;
  }
  @media (max-width: 760px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 46px 0 30px;
    }
    .intro h1 {
      font-size: 28px;
    }
    .intro-lead {
      font-size: 14px;
      margin: 25px 0;
    }
    .index {
      display: none;
    }
    .journal-row {
      grid-template-columns: minmax(0, 1fr) 18px;
      gap: 12px;
      padding: 24px 0;
    }
    .article-date {
      grid-column: 1/-1;
      display: flex;
      gap: 15px;
      align-items: center;
      padding: 0;
    }
    .article-date span {
      margin: 0;
    }
    .article-copy h3 {
      font-size: 17px;
    }
    .article-copy p {
      font-size: 12px;
    }
    .project,
    .personal-note {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .section-caption {
      display: none;
    }
    #work {
      margin-top: 55px;
    }
    .personal-note {
      margin-top: 55px;
    }
    .project-detail > p:first-child {
      font-size: 17px;
    }
  }

  .intro {
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 70px;
    padding-top: 72px;
    align-items: center;
  }
  .overline {
    display: inline-block;
    background: #e9f1fc;
    border: 1px solid #aec1da;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 11px;
    transform: rotate(-1deg);
  }
  .intro h1 {
    font-size: clamp(30px, 3.4vw, 44px);
    font-weight: 700;
    line-height: 1.7;
    letter-spacing: 0.04em;
  }
  .intro h1 > span {
    background: linear-gradient(
      transparent 75%,
      #ffe698 75%,
      #ffe698 95%,
      transparent 95%
    );
  }
  .intro-lead {
    font-size: 15px;
    margin: 24px 0 28px;
  }
  .index {
    padding: 22px 22px 16px;
    border: 1.5px solid #303d48;
    border-radius: 10px 12px 8px 9px;
    box-shadow: 5px 6px 0 #e5e8ed;
    transform: rotate(2deg);
    position: relative;
    background: #fff;
  }
  .index::before {
    content: "";
    position: absolute;
    top: -9px;
    left: 100px;
    width: 75px;
    height: 18px;
    background: #ffe493d9;
    border: 1px solid #dfbf69;
    transform: rotate(-6deg);
  }
  .index-title {
    font-size: 12px;
    margin-bottom: 14px;
    color: #394c5d;
  }
  .index a {
    border-top: 1px dashed #b8c0c8;
    padding: 16px 0;
  }
  .index a b {
    display: inline-block;
    padding: 0 6px;
    background: #e9f1fc;
  }
  .index a:nth-of-type(2) b {
    background: #e4f0e3;
  }
  .index a:nth-of-type(3) b {
    background: #fce4dc;
  }
  .section-heading {
    border-bottom: 1px dashed #adb4bb;
    padding-bottom: 20px;
  }
  .section-heading h2 {
    background: #fff0b8;
    border: 1.5px solid #303d48;
    padding: 8px 18px;
    font-size: 18px;
    border-radius: 5px;
    box-shadow: 2px 3px 0 #303d48;
    transform: rotate(-1deg);
  }
  #work .section-heading h2 {
    background: #e2efe4;
    transform: rotate(1deg);
  }
  .journal-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px;
    margin-top: 28px;
  }
  .journal-row {
    grid-template-columns: minmax(0, 1fr) 22px;
    gap: 16px;
    border: 1.5px solid #303d48;
    border-radius: 8px 10px 7px 9px;
    padding: 24px;
    box-shadow: 4px 4px 0 #e3ebf6;
    position: relative;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .journal-row:nth-child(2n) {
    box-shadow: 4px 4px 0 #f4e6d6;
  }
  .journal-row:hover {
    transform: translateY(-3px);
    box-shadow: 5px 7px 0 #d4e2f4;
  }
  .article-date {
    grid-column: 1/-1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0;
  }
  .article-date span {
    margin: 0;
    border-radius: 3px;
    background: #edf3fb;
    padding: 2px 8px;
  }
  .article-copy h3 {
    font-size: 18px;
  }
  .article-copy p {
    font-size: 12px;
  }
  .row-arrow {
    align-self: end;
  }
  .project {
    background: #f5f9f4;
    border: 1.5px solid #87998a;
    border-radius: 9px;
    padding: 35px;
    margin-top: 28px;
    gap: 45px;
  }
  .project-identity {
    border-left: 0;
    padding-left: 0;
  }
  .project-kicker {
    background: white;
    border: 1px solid #b2c3b5;
    padding: 4px 8px;
    border-radius: 3px;
  }
  .project-identity h3 {
    font-size: 42px;
  }
  .personal-note {
    border-top: 1px dashed #adb4bb;
  }
  .personal-note h2 {
    font-size: 17px;
  }
  @media (max-width: 760px) {
    .intro {
      grid-template-columns: 1fr;
      padding-top: 38px;
      gap: 34px;
    }
    .intro h1 {
      font-size: 30px;
    }
    .index {
      display: block;
      transform: rotate(0);
      padding: 20px;
      max-width: 100%;
      box-shadow: 3px 4px 0 #e5e8ed;
    }
    .index a {
      padding: 12px 0;
    }
    .journal-list {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .journal-row {
      padding: 20px;
      gap: 14px;
    }
    .section-heading h2 {
      font-size: 16px;
      padding: 7px 12px;
    }
    .section-heading {
      gap: 14px;
    }
    .article-copy h3 {
      font-size: 17px;
    }
    .project {
      padding: 25px 20px;
      gap: 28px;
    }
    .project-identity h3 {
      font-size: 37px;
    }
  }

  /* A small cabinet is the site's recurring wayfinding motif. */
  .intro {
    grid-template-columns: minmax(0, 1fr) 335px;
  }
  .index {
    border: 0;
    padding: 0;
    background: transparent;
    box-shadow: none;
    transform: none;
    overflow: visible;
  }
  .index::before {
    display: none;
  }
  .drawer-caption {
    text-align: center;
    margin-bottom: 22px;
    transform: rotate(-2deg);
  }
  .drawer-caption > span {
    font-family: "Yomogi Logo", sans-serif;
    font-size: 19px;
    display: block;
    line-height: 1.5;
  }
  .drawer-caption > b {
    display: block;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin: 5px 0;
  }
  .drawer-caption > small {
    font-size: 11px;
    color: var(--muted);
  }
  .drawer-box {
    border: 2px solid #303d48;
    border-radius: 9px 9px 4px 4px;
    background: #e7e1d6;
    padding: 10px 10px 15px;
    box-shadow: 7px 8px 0 #e8ebef;
    position: relative;
    isolation: isolate;
  }
  .drawer-box::before,
  .drawer-box::after {
    content: "";
    position: absolute;
    bottom: -10px;
    width: 25px;
    height: 10px;
    background: #303d48;
    border-radius: 0 0 3px 3px;
  }
  .drawer-box::before {
    left: 20px;
  }
  .drawer-box::after {
    right: 20px;
  }
  .drawer-box .drawer {
    position: relative;
    display: grid;
    grid-template-columns: 23px minmax(0, 1fr) 29px;
    align-items: center;
    gap: 10px;
    border: 1.5px solid #303d48;
    border-radius: 4px;
    background: #fff0b8;
    padding: 19px 14px;
    margin: 0 0 9px;
    box-shadow: 0 4px 0 #303d48;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
    min-height: 93px;
    transform-origin: center;
  }
  .drawer-box .drawer:last-child {
    margin-bottom: 0;
  }
  .drawer-box .drawer-research {
    background: #e3f1e7;
  }
  .drawer-box .drawer-work {
    background: #fce3db;
  }
  .drawer-number {
    align-self: start;
    font:
      11px/2 Atkinson,
      sans-serif;
    color: #58616a;
  }
  .drawer-label > b {
    background: white !important;
    border: 1px solid #303d4830;
    border-radius: 2px;
    padding: 1px 8px !important;
    font-size: 13px !important;
  }
  .drawer-label > b {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    min-width: 76px;
    padding: 3px 10px !important;
    line-height: 1.35;
  }
  .drawer-label > b > span[lang="en"] {
    font-family: "Yomogi Logo", sans-serif;
    font-size: 18px;
    font-weight: 400;
  }
  .drawer-ja {
    font-size: 9px;
    font-weight: 400;
    color: #4a555d;
    margin-top: 2px;
  }
  .drawer-label > small {
    font-size: 10px;
    color: #4a555d !important;
    margin-top: 7px;
    line-height: 1.6;
  }
  .drawer-handle {
    width: 27px;
    height: 9px;
    border: 1.5px solid #303d48;
    border-radius: 3px;
    background: #ffffffa6;
    box-shadow: 0 2px 0 #303d4840;
    transform: none !important;
  }
  .drawer-box .drawer:hover,
  .drawer-box .drawer:focus-visible {
    z-index: 3;
    transform: translate(-9px, 3px);
    box-shadow: 9px 9px 0 #303d48;
    color: var(--ink);
  }
  .drawer-box .drawer:active {
    transform: translate(0, 2px);
    box-shadow: 0 2px 0 #303d48;
  }
  .journal-row {
    border-radius: 4px 11px 7px 5px;
    border-top: 7px solid #f2d46c;
  }
  .journal-row:nth-child(2n) {
    border-top-color: #aecbe9;
  }
  .article-date span {
    background: #fff4cc;
  }
  .journal-row:nth-child(2n) .article-date span {
    background: #e9f1fc;
  }
  .project {
    border-top: 7px solid #a9c5ad;
  }
  .personal-note h2 {
    display: inline-block;
    align-self: start;
    justify-self: start;
    background: #fce3db;
    padding: 5px 10px;
    border-radius: 3px;
    transform: rotate(-1deg);
  }
  @media (max-width: 760px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 42px;
    }
    .index {
